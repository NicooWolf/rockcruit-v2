---
// src/pages/404.astro — port of v1's NotFound. Served by Apache via
// `ErrorDocument 404 /404.html` in public/.htaccess.
// Requires astronaut-not-found.svg in public/ (in the assets zip).
import Layout from "../layouts/Layout.astro";
import { href } from "../lib/url";
---

<Layout
  title="Page not found — Rockcruit"
  description="This page doesn't exist."
>
  <section class="nf">
    <img
      class="reveal"
      src={href("/astronaut-not-found.svg")}
      alt=""
      width="220"
      height="220"
    />
    <h1 class="reveal">
      <span class="mask-line"><span class="mask-inner">404</span></span>
    </h1>
    <p class="reveal">
      This page drifted off. <a href={href("/")}>Back to Earth →</a>
    </p>
  </section>
</Layout>

<style>
  .nf {
    min-height: 75vh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 1rem;
    padding: 6rem 5%;
  }
  .nf h1 {
    font-family: var(--bebas);
    font-weight: 400;
    font-size: 6rem;
    line-height: 1;
    color: var(--green);
  }
  .nf p {
    font-size: 0.95rem;
    color: rgba(240, 237, 227, 0.5);
  }
  .nf a {
    color: var(--green);
    text-decoration: none;
  }
  .nf a:hover {
    text-decoration: underline;
  }
</style>

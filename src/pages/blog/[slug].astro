---
// src/pages/blog/[slug].astro — one static HTML file per published post.
import Layout from "../../layouts/Layout.astro";
import { getAllPosts, getPostBySlug } from "../../lib/wp";
import { href } from "../../lib/url";
import { decodeEntities } from "../../lib/text";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);
if (!post) throw new Error(`Post not found at build time: ${slug}`);

const title = decodeEntities(post.title);
const metaDescription = decodeEntities(post.excerpt.replace(/<[^>]+>/g, ""))
  .trim()
  .slice(0, 160);
const dateLabel = new Date(post.date).toLocaleDateString("en-US", {
  dateStyle: "long",
});

// The author relation returns a list. Take the first author.
const author = post.postFields?.author?.nodes?.[0]?.authorFields;
const authorName = [author?.name, author?.lastName].filter(Boolean).join(" ");

const image = post.postFields?.postImage?.node;
---

<Layout title={`${title} — Rockcruit`} description={metaDescription}>
  <article class="post">
    <header class="post-header">
      <div class="reveal">
        <a class="post-back" href={href("/blog")}>← All posts</a>
      </div>
      <h1 class="post-h1 reveal">
        <span class="mask-line"><span class="mask-inner">{title}</span></span>
      </h1>
      <time class="post-meta reveal" datetime={post.date}>{dateLabel}</time>
    </header>

    <div class="post-content reveal soft">
      <div class="post-content-header">
        {post.postFields?.subtitle && <h2>{post.postFields.subtitle}</h2>}
        {post.postFields?.description && <p>{post.postFields.description}</p>}
      </div>
      {
        image?.sourceUrl && (
          <figure class="post-figure">
            <img src={image.sourceUrl} alt={image.altText ?? ""} decoding="async" />
          </figure>
        )
      }
      {/* The owner writes this HTML in the WordPress CMS. */}
      {post.content && <div class="post-body" set:html={post.content} />}
      {
        authorName && (
          <span class="post-content-author">
            <span class="post-content-author-label">Written by</span>
            <span class="post-content-author-name">{authorName}</span>
          </span>
        )
      }
    </div>

    <footer class="post-footer">
      <p class="post-cta-line reveal">Hiring for a role like this?</p>
      <div class="reveal">
        <a href={href("/#contact")} class="btn-primary">Talk to us →</a>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .post {
    padding: 6.5rem 5% 4rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .post-header {
    border-bottom: 1px solid var(--bdark);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .post-back {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 35%, transparent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .post-back:hover {
    color: var(--green);
  }
  .post-h1 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--paper);
    margin: 1.5rem 0 1rem;
  }
  /* The mask clips the line box. This padding keeps the italic descenders. */
  .post-h1 .mask-inner {
    padding-bottom: 0.1em;
  }
  .post-meta {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 30%, transparent);
  }
  .post-content {
    margin-top: 2rem;
    margin-bottom: 6rem;
    font-size: 0.98rem;
    line-height: 1.9;
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }
  /* Author byline. It sits after the content, aligned to the bottom right. */
  .post-content-author {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    margin-top: 2.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--bdark);
    text-align: right;
  }
  .post-content-author-label {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 30%, transparent);
  }
  .post-content-author-name {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--paper);
  }
  .post-figure {
    margin: 2.5rem 0 1rem;
  }
  .post-figure img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
  }
  /* WordPress HTML can carry inline colors and fonts. These rules replace
     them with the brand fonts and colors. */
  .post-body :global([style]),
  .post-body :global(font) {
    color: inherit !important;
    background-color: transparent !important;
    font-family: inherit !important;
  }
  .post-body :global(h2[style]) {
    font-family: var(--serif) !important;
  }
  .post-body :global(h3[style]) {
    font-family: var(--bebas) !important;
  }
  .post-body :global(a[style]) {
    color: var(--green) !important;
  }
  /* WP content arrives unscoped-able — :global() lets scoped CSS style it */
  .post-content :global(h2) {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.7rem;
    color: var(--paper);
    margin: 2.5rem 0 1rem;
  }
  .post-content :global(h3) {
    font-family: var(--bebas);
    font-weight: 400;
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    color: var(--paper);
    margin: 2rem 0 0.8rem;
  }
  .post-content :global(p) {
    margin-bottom: 1.2rem;
  }
  .post-content :global(a) {
    color: var(--green);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--green-rgb), 0.35);
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.2rem 1.4rem;
  }
  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
  .post-content :global(blockquote) {
    border-left: 2px solid var(--green);
    padding-left: 1.2rem;
    font-family: var(--serif);
    font-style: italic;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    margin: 1.8rem 0;
  }
  .post-content :global(pre) {
    background: var(--bg-base);
    border: 1px solid var(--bdark);
    border-radius: 8px;
    padding: 1.2rem;
    overflow-x: auto;
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.82rem;
    margin: 1.5rem 0;
  }
  .post-footer {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--bdark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .post-cta-line {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.2rem;
    color: color-mix(in srgb, var(--paper) 50%, transparent);
  }
  .btn-primary {
    background: var(--green);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .btn-primary:hover {
    background: var(--green-light);
    transform: translateY(-2px);
  }
</style>

---
// src/pages/blog/[slug].astro — one static HTML file per published post.
import Layout from "../../layouts/Layout.astro";
import { getAllPosts, getPostBySlug } from "../../lib/wp";
import { href } from "../../lib/url";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);
if (!post) throw new Error(`Post not found at build time: ${slug}`);

const metaDescription = post.excerpt
  .replace(/<[^>]+>/g, "")
  .trim()
  .slice(0, 160);
const dateLabel = new Date(post.date).toLocaleDateString("en-US", {
  dateStyle: "long",
});

// The author relation returns a list. Take the first author.
const author = post.postFields?.author?.nodes?.[0]?.authorFields;
const authorName = [author?.name, author?.lastName].filter(Boolean).join(" ");
---

<Layout title={`${post.title} — Rockcruit`} description={metaDescription}>
  <article class="post">
    <header class="post-header reveal">
      <a class="post-back" href={href("/blog")}>← All posts</a>
      <h1 class="post-h1">{post.title}</h1>
      <time class="post-meta" datetime={post.date}>{dateLabel}</time>
    </header>

    <div class="post-content reveal">
      <div class="post-content-header">
        <h2>{post.postFields?.subtitle}</h2>
        <p>{post.postFields?.description}</p>
        {
          authorName && (
            <span class="post-content-author">
              <span class="post-content-author-label">Written by</span>
              <span class="post-content-author-name">{authorName}</span>
            </span>
          )
        }
      </div>
    </div>

    <footer class="post-footer reveal">
      <p class="post-cta-line">Hiring for a role like this?</p>
      <a href={href("/#contact")} class="btn-primary">Talk to us →</a>
    </footer>
  </article>
</Layout>

<style>
  .post {
    padding: 6.5rem 5% 4rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .post-header {
    border-bottom: 1px solid var(--bdark);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .post-back {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240, 237, 227, 0.35);
    text-decoration: none;
    transition: color 0.2s;
  }
  .post-back:hover {
    color: var(--green);
  }
  .post-h1 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--paper);
    margin: 1.5rem 0 1rem;
  }
  .post-meta {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(240, 237, 227, 0.3);
  }
  .post-content {
    margin-top: 2rem;
    margin-bottom: 6rem;
    font-size: 0.98rem;
    line-height: 1.9;
    color: rgba(240, 237, 227, 0.7);
  }
  /* Author byline. It sits after the content, aligned to the bottom right. */
  .post-content-author {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    margin-top: 2.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--bdark);
    text-align: right;
  }
  .post-content-author-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(240, 237, 227, 0.3);
  }
  .post-content-author-name {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--paper);
  }
  /* WP content arrives unscoped-able — :global() lets scoped CSS style it */
  .post-content :global(h2) {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.7rem;
    color: var(--paper);
    margin: 2.5rem 0 1rem;
  }
  .post-content :global(h3) {
    font-family: var(--bebas);
    font-weight: 400;
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    color: var(--paper);
    margin: 2rem 0 0.8rem;
  }
  .post-content :global(p) {
    margin-bottom: 1.2rem;
  }
  .post-content :global(a) {
    color: var(--green);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--green-rgb), 0.35);
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.2rem 1.4rem;
  }
  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
  .post-content :global(blockquote) {
    border-left: 2px solid var(--green);
    padding-left: 1.2rem;
    font-family: var(--serif);
    font-style: italic;
    color: rgba(240, 237, 227, 0.55);
    margin: 1.8rem 0;
  }
  .post-content :global(pre) {
    background: #0b0b0b;
    border: 1px solid var(--bdark);
    border-radius: 8px;
    padding: 1.2rem;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.82rem;
    margin: 1.5rem 0;
  }
  .post-footer {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--bdark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .post-cta-line {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    color: rgba(240, 237, 227, 0.5);
  }
  .btn-primary {
    background: var(--green);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .btn-primary:hover {
    background: var(--green-light);
    transform: translateY(-2px);
  }
</style>

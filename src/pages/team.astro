---
// src/pages/team.astro — NEW page (no prototype existed).
// Built in the established design system; copy grounded in v1's AboutUs section
// ("Specialized Knowledge" + domain list). The typewriter effect is dropped per
// CLAUDE.md animation non-goals — domains render as a static mono list.
// TODO(team): add the photos of the members. The names and the roles are real.
import Layout from "../layouts/Layout.astro";
import { href } from "../lib/url";
---

<Layout
  title="Team — Rockcruit"
  description="The people behind Rockcruit — tech headhunters with years of experience identifying and attracting top technical talent across LATAM."
>
  <div class="page-hero reveal">
    <div class="page-hero-glow"></div>
    <div class="page-hero-label">Who you'll work with</div>
    <h1 class="page-hero-h">
      <span>RECRUITERS WHO</span>
      <span>ACTUALLY KNOW</span>
      <span class="dim">TECH.</span>
    </h1>
    <p class="page-hero-sub">
      With years of experience in the tech industry, we have honed our expertise
      in identifying and attracting top technical talent across various domains. <strong
        >Small team, senior judgment, zero hand-offs to juniors.</strong
      >
    </p>
  </div>

  <!-- Specialized knowledge — v1 AboutUs content, static -->
  <section class="domains">
    <div class="domains-header reveal">
      <div class="d-eyebrow">Specialized knowledge</div>
      <h2 class="d-h2">
        We recruit across<br /><em>every digital domain.</em>
      </h2>
    </div>
    <!-- The track holds the list two times. The animation moves it by one half,
       so the second half arrives on the place of the first one and the line
       never stops. The tags carry a margin, not a gap, because a gap makes the
       two halves unequal and the line then jumps. -->
    <div class="domains-marquee reveal">
      <div class="domains-track">
        {
          [0, 1].map(() => (
            <>
              <span class="domain-tag">Software Development</span>
              <span class="domain-tag">Product &amp; Management</span>
              <span class="domain-tag">Software Architecture</span>
              <span class="domain-tag">Artificial Intelligence</span>
              <span class="domain-tag">Infrastructure &amp; Support</span>
              <span class="domain-tag">Data / ML</span>
              <span class="domain-tag">DevOps / Cloud</span>
              <span class="domain-tag">Tech Sales</span>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Who we are — accordion, mirrors the Home "diff" section -->
  <section class="story">
    <div class="story-header">
      <h2 class="story-h2 reveal">
        Who we <em>are.</em>
      </h2>
      <p class="story-sub reveal">
        Two founders. Senior judgment. Zero hand-offs.
      </p>
    </div>

    <div class="story-item open reveal">
      <button class="story-item-btn"
        ><span class="si-num">01</span><span class="si-title"
          >Who <em>we are</em></span
        ><span class="si-icon">+</span></button
      >
      <div class="si-body">
        <div class="si-body-inner">
          We're Agustina and Julieta, co-founders of Rockcruit. We met while
          working at a global tech company and later at a high-growth
          organization, where we realized something rare in recruiting: we
          shared the same judgment, pace, and way of working. From day one, we
          became a natural team — collaborating, solving complex searches, and
          complementing each other's strengths.
        </div>
      </div>
    </div>

    <div class="story-item reveal">
      <button class="story-item-btn"
        ><span class="si-num">02</span><span class="si-title"
          >How Rockcruit <em>started</em></span
        ><span class="si-icon">+</span></button
      >
      <div class="si-body">
        <div class="si-body-inner">
          After years of working side by side, the idea of building something of
          our own felt inevitable. We wanted a different model: senior
          recruiters, clear processes, zero hand-offs, and real partnership with
          every client. That's how Rockcruit was born. Three years later, we've
          grown independently, supporting companies worldwide and helping teams
          scale across different markets.
        </div>
      </div>
    </div>

    <div class="story-item reveal">
      <button class="story-item-btn"
        ><span class="si-num">03</span><span class="si-title"
          >What sets us <em>apart</em></span
        ><span class="si-icon">+</span></button
      >
      <div class="si-body">
        <div class="si-body-inner">
          <ul class="si-list">
            <li>A small team with big judgment.</li>
            <li>Every search is handled directly by us: no delegation.</li>
            <li>A tech-native approach, not traditional HR.</li>
            <li>Transparency, speed, and quality as non-negotiables.</li>
            <li>We work as an extension of each client's team.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Members -->
  <section class="members">
    <div class="members-glow"></div>
    <div class="members-header reveal">
      <div class="d-eyebrow">The team</div>
      <h2 class="d-h2">People, not <em>pipelines.</em></h2>
    </div>
    <!-- TODO(team): photos. Swap the .member-av span for
       <img src="/team/<name>.webp" alt="" /> when the photos exist. -->
    <div class="members-grid">
      <div class="member-card reveal">
        <div class="member-av"><span>JW</span></div>
        <div class="member-name">Julieta Wolf</div>
        <div class="member-role">Co-Founder</div>
        <p class="member-bio">
          Julieta is an expert in client partnership, search strategy, and
          talent positioning. She leads commercial strategy, discovery, role
          definition, and sourcing direction.
        </p>
        <p class="member-bio">
          She works closely with clients to understand what they truly need,
          what will work, and how to design a search process that attracts the
          right talent.
        </p>
      </div>
      <div class="member-card reveal">
        <div class="member-av"><span>AV</span></div>
        <div class="member-name">Agustina Valverde</div>
        <div class="member-role">Co-Founder</div>
        <p class="member-bio">
          Agustina specializes in strategic recruiting for commercial,
          technical, and leadership roles. She has experience building teams for
          startups and tech companies across multiple markets.
        </p>
        <p class="member-bio">
          Within Rockcruit, she leads operations, process design, quality, and
          candidate experience, ensuring every search runs with structure,
          clarity, and consistency.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="team-cta reveal">
    <p class="team-cta-line">
      Want to know who'd run <strong>your</strong> search?
    </p>
    <a href={href("/#contact")} class="btn-primary">Start the conversation →</a>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 6.5rem 5% 4rem;
    border-bottom: 1px solid var(--bdark);
    position: relative;
    overflow: hidden;
  }
  .page-hero-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: rgba(var(--green-rgb), 0.05);
    filter: blur(80px);
    pointer-events: none;
  }
  .page-hero-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 2rem;
  }
  .page-hero-h {
    font-family: var(--bebas);
    font-weight: 400;
    font-size: clamp(4rem, 10vw, 11rem);
    line-height: 0.86;
    letter-spacing: 0.02em;
    color: var(--paper);
    margin-bottom: 2.5rem;
  }
  .page-hero-h span {
    display: block;
  }
  .page-hero-h .dim {
    color: rgba(240, 237, 227, 0.2);
  }
  .page-hero-sub {
    font-size: 0.95rem;
    color: #a1a1aa;
    line-height: 1.8;
    max-width: 540px;
  }
  .page-hero-sub strong {
    color: var(--paper);
    font-weight: 400;
  }

  .d-eyebrow {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1.2rem;
  }
  .d-h2 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--paper);
  }
  .d-h2 em {
    font-style: normal;
    color: var(--green);
  }

  .domains {
    padding: 3rem 0;
    border-bottom: 1px solid var(--bdark);
  }
  .domains-header {
    margin: 0 5% 1.8rem;
  }
  /* The line of tags keeps the 5% margin of the header, so it starts under the
   first letter of the title. The mask makes a tag fade away at the two ends,
   in place of a hard cut. A mask color gives opacity only. It is not a color
   of the design. */
  .domains-marquee {
    overflow: hidden;
    margin: 0 5%;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 min(90px, 15%),
      #000 calc(100% - min(90px, 15%)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 min(90px, 15%),
      #000 calc(100% - min(90px, 15%)),
      transparent 100%
    );
  }
  .domains-track {
    display: flex;
    width: max-content;
    animation: domains-mq 45s linear infinite;
  }
  @keyframes domains-mq {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .domain-tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(240, 237, 227, 0.6);
    border: 1px solid var(--bdark);
    border-radius: 4px;
    padding: 0.6rem 1rem;
    margin-right: 0.8rem;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .domain-tag:hover {
    border-color: var(--green);
    color: var(--green);
  }
  @media (prefers-reduced-motion: reduce) {
    .domains-track {
      animation: none;
    }
  }

  .story {
    border-bottom: 1px solid var(--bdark);
  }
  .story-header {
    padding: 4rem 5% 3rem;
    border-bottom: 1px solid var(--bdark);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 4rem;
    flex-wrap: wrap;
  }
  .story-h2 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--paper);
  }
  .story-h2 em {
    font-style: normal;
    color: var(--green);
  }
  .story-sub {
    font-size: 0.88rem;
    color: rgba(240, 237, 227, 0.35);
    line-height: 1.7;
    text-align: right;
    white-space: nowrap;
  }
  .story-item {
    border-bottom: 1px solid var(--bdark);
    overflow: hidden;
  }
  .story-item-btn {
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: 80px 1fr 36px;
    align-items: center;
    gap: 2rem;
    padding: 2rem 5%;
    text-align: left;
    transition: background 0.2s;
  }
  .story-item-btn:hover {
    background: rgba(255, 255, 255, 0.03);
  }
  .story-item.open .story-item-btn {
    background: rgba(255, 255, 255, 0.04);
  }
  .si-num {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .si-title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--paper);
  }
  .si-title em {
    font-style: normal;
    color: var(--green);
  }
  .story-item.open .si-title {
    color: var(--green);
  }
  .si-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--bdark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(240, 237, 227, 0.3);
    font-size: 0.9rem;
    flex-shrink: 0;
    transition:
      border-color 0.2s,
      color 0.2s,
      transform 0.35s;
  }
  .story-item.open .si-icon {
    border-color: var(--green);
    color: var(--green);
    transform: rotate(45deg);
  }
  .si-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s ease;
  }
  .si-body-inner {
    padding: 0.5rem 5% 2rem calc(5% + 80px + 2rem);
    font-size: 0.88rem;
    color: rgba(240, 237, 227, 0.45);
    line-height: 1.85;
  }
  .story-item.open .si-body {
    max-height: 420px;
  }
  .si-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .si-list li {
    padding-left: 1.4rem;
    position: relative;
  }
  .si-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--green);
    font-family: var(--mono);
  }
  @media (max-width: 640px) {
    .story-header {
      flex-direction: column;
      gap: 1rem;
    }
    .story-sub {
      text-align: left;
      white-space: normal;
    }
    .story-item-btn {
      grid-template-columns: 50px 1fr 34px;
      gap: 1rem;
      padding: 1.5rem 5%;
    }
    .si-body-inner {
      padding: 0.5rem 5% 1.5rem calc(5% + 50px + 1rem);
    }
    .story-item.open .si-body {
      max-height: 560px;
    }
  }

  .members {
    padding: 4rem 5%;
    border-bottom: 1px solid var(--bdark);
    background: rgba(255, 255, 255, 0.015);
    position: relative;
    overflow: hidden;
  }
  .members-glow {
    position: absolute;
    bottom: -60px;
    left: -60px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: rgba(var(--violet-rgb), 0.05);
    filter: blur(80px);
    pointer-events: none;
  }
  .members-header {
    margin-bottom: 3rem;
  }
  /* This section carries the violet. The section above it carries the green. */
  .members .d-eyebrow {
    color: var(--violet-light);
  }
  .members .d-h2 em {
    color: var(--violet-light);
  }
  .members-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 768px) {
    .members-grid {
      grid-template-columns: 1fr;
    }
  }
  .member-card {
    border: 1px solid var(--bdark);
    border-radius: 12px;
    padding: 1.5rem 1.8rem;
    transition:
      border-color 0.3s,
      transform 0.3s;
  }
  .member-card:hover {
    border-color: rgba(var(--violet-light-rgb), 0.3);
    transform: translateY(-4px);
  }
  .member-av {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(var(--violet-light-rgb), 0.1);
    border: 1px solid rgba(var(--violet-light-rgb), 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .member-av span {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--violet-light);
  }
  .member-name {
    font-family: var(--bebas);
    font-weight: 400;
    font-size: 1.5rem;
    letter-spacing: 0.03em;
    color: var(--paper);
  }
  .member-role {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--violet-light);
    margin: 0.3rem 0 1rem;
  }
  .member-bio {
    font-size: 0.84rem;
    color: rgba(240, 237, 227, 0.45);
    line-height: 1.75;
  }
  .member-bio + .member-bio {
    margin-top: 0.9rem;
  }

  .team-cta {
    padding: 1rem 5%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.8rem;
  }
  .team-cta-line {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    color: rgba(240, 237, 227, 0.5);
  }
  .team-cta-line strong {
    color: var(--paper);
    font-weight: 400;
  }
  .btn-primary {
    background: var(--green);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.65rem 1.2rem;
    border-radius: 4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .btn-primary:hover {
    background: var(--green-light);
    transform: translateY(-2px);
  }
  @media (max-width: 768px) {
    .team-cta {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<script>
  // Accordion — event delegation. It mirrors the Home "diff" section.
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest?.(".story-item-btn");
    if (!btn) return;
    const item = btn.closest(".story-item");
    const wasOpen = item?.classList.contains("open");
    document
      .querySelectorAll(".story-item")
      .forEach((i) => i.classList.remove("open"));
    if (!wasOpen) item?.classList.add("open");
  });
</script>

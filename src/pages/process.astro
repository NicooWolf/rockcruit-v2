---
// src/pages/process.astro — NEW page (no prototype existed).
// The four steps are v1's real copy (src/lib/constants.ts → recruitingProcessCards),
// rendered in the prototypes' pillars-row pattern. Numbered markers are appropriate
// here: this content IS a sequence.
import Layout from "../layouts/Layout.astro";
import { href } from "../lib/url";

const steps = [
  {
    title: "Job Description",
    body: "In case you don't have one defined, we will help you put together a comprehensive job description that will serve as the basis for our subsequent work.",
  },
  {
    title: "Active Sourcing",
    body: "We utilize various strategies to identify and attract the most qualified candidates for the position. Proactive outreach — no waiting for inbound applicants.",
  },
  {
    title: "Interview",
    body: "We conduct an analysis of candidates' skills and competencies, including technical skills and assessment of English proficiency. Culture fit is evaluated from this first conversation — not at the offer stage.",
  },
  {
    title: "Presentation",
    body: "We provide a detailed report along with the candidate's resume — pipeline status and market feedback included, no black boxes.",
  },
];
---

<Layout
  title="Process — Rockcruit"
  description="From job description to signed offer: how a Rockcruit search runs. First candidate in 3–5 days, average fill in 3–4 weeks."
>
  <div class="page-hero reveal">
    <div class="page-hero-glow"></div>
    <div class="page-hero-label">How a search runs</div>
    <h1 class="page-hero-h">
      <span>KICKOFF TO</span>
      <span>SIGNED OFFER,</span>
      <span class="dim">NO BLACK BOXES.</span>
    </h1>
    <p class="page-hero-sub">
      The same embedded standard powers every engagement — Contingency or RaaS. <strong
        >First candidate in 3–5 days. Average fill in 3–4 weeks.</strong
      > Here's what happens in between.
    </p>
  </div>

  <section class="steps">
    <div class="steps-list">
      {
        steps.map((step, i) => (
          <div class="step-row reveal">
            <div class="step-num">{String(i + 1).padStart(2, "0")}</div>
            <div class="step-title">{step.title}</div>
            <p class="step-body">{step.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="process-closing reveal">
    <p class="pc-line">
      Then it repeats — <strong>sharper each time.</strong><br />Every search
      adds context the next one starts with.
    </p>
    <div class="pc-ctas">
      <a href={href("/#contact")} class="btn-primary">Start a search →</a>
      <a href={href("/services")} class="btn-ghost">
        Compare delivery models →
      </a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 6.5rem 5% 4rem;
    border-bottom: 1px solid var(--bdark);
    position: relative;
    overflow: hidden;
  }
  .page-hero-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: rgba(var(--green-rgb), 0.05);
    filter: blur(80px);
    pointer-events: none;
  }
  .page-hero-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 2rem;
  }
  .page-hero-h {
    font-family: var(--bebas);
    font-size: clamp(3.5rem, 9vw, 10rem);
    line-height: 0.86;
    letter-spacing: 0.02em;
    color: var(--paper);
    margin-bottom: 2.5rem;
  }
  .page-hero-h span {
    display: block;
  }
  .page-hero-h .dim {
    color: rgba(240, 237, 227, 0.2);
  }
  .page-hero-sub {
    font-size: 0.95rem;
    color: #a1a1aa;
    line-height: 1.8;
    max-width: 540px;
  }
  .page-hero-sub strong {
    color: var(--paper);
    font-weight: 400;
  }

  .steps {
    border-bottom: 1px solid var(--bdark);
  }
  .step-row {
    display: grid;
    grid-template-columns: 80px 1fr 1.4fr;
    gap: 2.5rem;
    align-items: center;
    padding: 2.4rem 5%;
    border-bottom: 1px solid var(--bdark);
    transition: background 0.2s;
  }
  .step-row:last-child {
    border-bottom: none;
  }
  .step-row:hover {
    background: rgba(255, 255, 255, 0.02);
  }
  .step-num {
    font-family: var(--bebas);
    font-size: 2.4rem;
    line-height: 1;
    color: rgba(var(--green-rgb), 0.5);
  }
  .step-title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    color: var(--paper);
    letter-spacing: -0.01em;
  }
  .step-body {
    font-size: 0.86rem;
    color: rgba(240, 237, 227, 0.45);
    line-height: 1.8;
  }

  .process-closing {
    padding: 5rem 5%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }
  .pc-line {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.2rem, 2.4vw, 1.8rem);
    color: rgba(240, 237, 227, 0.45);
    line-height: 1.5;
  }
  .pc-line strong {
    color: var(--green);
    font-weight: 400;
  }
  .pc-ctas {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--green);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .btn-primary:hover {
    background: var(--green-light);
    transform: translateY(-2px);
  }
  .btn-ghost {
    font-size: 0.88rem;
    color: rgba(240, 237, 227, 0.45);
    text-decoration: none;
    border: 1px solid var(--bdark);
    border-radius: 4px;
    padding: 0.85rem 2rem;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .btn-ghost:hover {
    border-color: rgba(240, 237, 227, 0.4);
    color: var(--paper);
  }

  @media (max-width: 1024px) {
    .step-row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .step-num {
      font-size: 1.8rem;
    }
  }
</style>

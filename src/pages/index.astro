---
// src/pages/index.astro — Home. Port of prototype index.html (structural refactor, not redesign).
import Layout from "../layouts/Layout.astro";
import HireForm from "../components/HireForm.astro";

import { href } from "../lib/url";
---

<Layout
  title="Rockcruit — Tech Headhunters · LATAM"
  description="Embedded tech recruiting for scaling companies across LATAM. First candidate in 5 days, no per-hire fees on RaaS."
>
  <!-- ═══════ HERO ═══════ -->
  <section class="hero" id="top">
    <div class="hero-glow"></div>

    <div class="hero-eyebrow-row reveal">
      <span class="hero-eyebrow">Tech headhunters · LATAM</span>
    </div>

    <div class="hero-h1-wrap reveal">
      <h1>
        <span class="hl-ink">FAST-GROWING</span>
        <span class="hl-green">TEAMS NEED</span>
        <span class="hl-ink">BETTER HIRING</span>
        <span class="hl-muted">PARTNERS.</span>
      </h1>
    </div>

    <div class="subhero-grid reveal">
      <div class="subhero-left">
        <h2 class="subhero-title">
          When growth accelerates, most talent teams become <strong
            >overloaded fast.</strong
          >
        </h2>
        <p class="subhero-body">
          We plug in as an embedded recruiting layer focused on high-impact
          digital roles across LATAM — helping scaling companies hire faster
          without increasing fixed recruiting headcount.
        </p>
        <div class="subhero-ctas">
          <a href={href("/#contact")} class="btn-primary">Start hiring →</a>
          <a href={href("/services")} class="btn-ghost-sub">See how we work →</a
          >
        </div>
      </div>
      <div class="subhero-right">
        <div class="subhero-prop">
          <div class="subhero-icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><polyline
                points="12 6 12 12 16 14"></polyline></svg
            >
          </div>
          <div>
            <div class="subhero-prop-title">First candidate in 5 days</div>
            <div class="subhero-prop-sub">
              In 85% of our searches — no waiting for inbound applicants.
            </div>
          </div>
        </div>
        <div class="subhero-prop">
          <div class="subhero-icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="3" width="20" height="14" rx="2"></rect><path
                d="M8 21h8M12 17v4"></path></svg
            >
          </div>
          <div>
            <div class="subhero-prop-title">Embedded in your workflow</div>
            <div class="subhero-prop-sub">
              We operate inside Slack, Teams, and your hiring process — not
              outside of it.
            </div>
          </div>
        </div>
        <div class="subhero-prop">
          <div class="subhero-icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path></svg
            >
          </div>
          <div>
            <div class="subhero-prop-title">
              No cold starts between searches
            </div>
            <div class="subhero-prop-sub">
              Context from every previous search makes the next one faster and
              sharper.
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-stats">
      <div class="stat-item reveal">
        <div class="stat-num g">+10,000</div>
        <div class="stat-label">Qualified candidates in our network</div>
      </div>
      <div class="stat-item featured reveal">
        <div class="stat-num v">3–5 DAYS</div>
        <div class="stat-label">To first candidate from kickoff</div>
      </div>
      <div class="stat-item reveal">
        <div class="stat-num g">3–4 WEEKS</div>
        <div class="stat-label">Average time to fill a role</div>
      </div>
    </div>
  </section>

  <!-- ═══════ TRUSTED BY ═══════ -->
  <div class="logos">
    <div class="logos-label">Trusted by</div>
    <div class="logos-track">
      {
        [0, 1].map(() => (
          <>
            <>
              <div class="logo-item">
                <span class="logo-text">Magoya</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Patagonian</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Sidom</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Hearth</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Hiberus</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Aureum</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Bizland</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Bricks M2V</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Bridgenext</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">EGA</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Wunderkind</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">iplan</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">TGN</span>
              </div>
              <div class="logo-item">
                <span class="logo-text">Eureka Labs</span>
              </div>
            </>
          </>
        ))
      }
    </div>
  </div>

  <!-- ═══════ CORE POSITIONING ═══════ -->
  <section class="positioning">
    <div class="pos-header reveal">
      <div class="pos-eyebrow">Why companies switch to Rockcruit</div>
      <h2 class="pos-h2">
        Most recruiting firms restart from zero <em>every search.</em> We don't.
      </h2>
      <div class="pos-intro">
        <p>Traditional recruiting works transaction by transaction.</p>
        <p>But scaling teams don't hire that way.</p>
        <p>
          Every new search forces external recruiters to relearn your culture,
          your hiring standards, your interview process, and what actually makes
          someone succeed inside your company. That creates friction, slow
          ramp-up time, and inconsistent candidate quality.
        </p>
      </div>
    </div>

    <div class="pos-cols">
      <div class="pos-col reveal">
        <div class="pos-col-num">01</div>
        <div class="pos-col-title">Embedded, not external</div>
        <p class="pos-col-body">
          We operate inside your workflow, not outside of it. Slack, Teams,
          weekly calibration, direct hiring alignment — like an internal
          recruiting function with external flexibility.
        </p>
      </div>
      <div class="pos-col reveal">
        <div class="pos-col-num">02</div>
        <div class="pos-col-title">Context compounds over time</div>
        <p class="pos-col-body">
          Every search improves the next one. We build pattern recognition
          around your culture, your leadership team, and the profiles that
          actually succeed long term.
        </p>
      </div>
      <div class="pos-col reveal">
        <div class="pos-col-num">03</div>
        <div class="pos-col-title">Elastic recruiting capacity</div>
        <p class="pos-col-body">
          Activate support when hiring spikes hit. Scale down when the pressure
          drops. No unnecessary fixed recruiting headcount between growth
          cycles.
        </p>
      </div>
    </div>

    <div class="pos-footer reveal">
      <p class="pos-closing">
        Anyone can send resumes.<br /><strong
          >Very few recruiting partners actually learn how your company hires.</strong
        >
      </p>
      <a href={href("/services")} class="pos-cta"
        >Explore our delivery models →</a
      >
    </div>
  </section>

  <!-- ═══════ DIFFERENTIATORS (accordion) ═══════ -->
  <section class="diff">
    <div class="diff-header">
      <h2 class="diff-h2 reveal">
        What you'll actually feel<br />working with <em>us.</em>
      </h2>
      <p class="diff-sub reveal">
        Not buzzwords. Operational differences that change how hiring moves.
      </p>
    </div>

    <div class="diff-item open reveal">
      <button class="diff-item-btn"
        ><span class="di-num">01</span><span class="di-title"
          >First candidate in <em>5 days</em></span
        ><span class="di-icon">+</span></button
      >
      <div class="di-body">
        <div class="di-body-inner">
          In 85% of our searches, we present the first candidate within the
          first 5 business days. No waiting weeks for inbound applicants. No
          empty progress updates.
        </div>
      </div>
    </div>
    <div class="diff-item reveal">
      <button class="diff-item-btn"
        ><span class="di-num">02</span><span class="di-title"
          >Embedded recruiting <em>partnership</em></span
        ><span class="di-icon">+</span></button
      >
      <div class="di-body">
        <div class="di-body-inner">
          We integrate into your hiring process and represent your company like
          an internal team would — not like an external vendor forwarding
          resumes.
        </div>
      </div>
    </div>
    <div class="diff-item reveal">
      <button class="diff-item-btn"
        ><span class="di-num">03</span><span class="di-title"
          >Culture fit matters as much as <em>technical fit</em></span
        ><span class="di-icon">+</span></button
      >
      <div class="di-body">
        <div class="di-body-inner">
          Strong technical profiles fail all the time for cultural reasons. We
          evaluate both from the first conversation — not just at the offer
          stage.
        </div>
      </div>
    </div>
    <div class="diff-item reveal">
      <button class="diff-item-btn"
        ><span class="di-num">04</span><span class="di-title"
          ><em>Transparent</em> communication</span
        ><span class="di-icon">+</span></button
      >
      <div class="di-body">
        <div class="di-body-inner">
          No black boxes. No disappearing recruiters. You always know pipeline
          status, market feedback, and where searches stand.
        </div>
      </div>
    </div>

    <div class="diff-footer reveal">
      <p class="diff-closing">
        The goal isn't sending more candidates.<br /><strong
          >It's reducing hiring mistakes.</strong
        >
      </p>
    </div>
  </section>

  <!-- ═══════ SERVICES TEASER ═══════ -->
  <section class="services-teaser">
    <div class="st-header reveal">
      <div class="st-eyebrow">Delivery models</div>
      <h2 class="st-h2">Two ways to<br />work with <em>us.</em></h2>
      <p class="st-intro">
        The right model depends mostly on one thing:<br />how often you hire.
      </p>
    </div>
    <div class="st-cards">
      <div class="st-card reveal">
        <div class="st-card-num">01</div>
        <div class="st-card-title">For companies<br />hiring continuously.</div>
        <p class="st-card-body">
          An embedded recruiting model designed for companies making multiple
          digital hires per year. Continuous sourcing, accumulated context, and
          flexible monthly engagement without per-hire fees.
        </p>
        <a href={href("/services#raas")} class="st-card-link">See RaaS →</a>
        <div class="st-card-bg">01</div>
      </div>
      <div class="st-card reveal">
        <div class="st-card-num">02</div>
        <div class="st-card-title">For focused,<br />isolated searches.</div>
        <p class="st-card-body">
          A structured headhunting engagement for critical one-off hires where
          precision, speed, and deep vetting matter most.
        </p>
        <a href={href("/services#contingency")} class="st-card-link"
          >See Contingency →</a
        >
        <div class="st-card-bg">02</div>
      </div>
    </div>
  </section>

  <!-- ═══════ TESTIMONIALS (carousel) ═══════ -->
  <section class="testimonials">
    <div class="testi-top">
      <div>
        <div class="testi-eyebrow reveal">Client reviews</div>
        <h2 class="testi-h2 reveal">What our<br /><em>clients say.</em></h2>
      </div>
      <p class="testi-sub reveal">
        Real feedback from leaders hiring digital talent under pressure.
      </p>
    </div>
    <div class="testi-grid reveal">
      <div class="testi-viewport">
        <div class="testi-track">
          <div class="testi-card">
            <span class="testi-qmark">"</span><p class="testi-text">
              The quality of profiles was completely different from what we were
              used to. They clearly understood our team dynamics — not just the
              job description.
            </p><div class="testi-author">
              <div class="testi-av">
                <span class="testi-initials">MR</span>
              </div><div>
                <div class="testi-name">M. Rodriguez</div><div
                  class="testi-role"
                >
                  Head of People · Magoya
                </div>
              </div>
            </div>
          </div>
          <div class="testi-card">
            <span class="testi-qmark">"</span><p class="testi-text">
              We'd been trying to fill a senior DevOps role for months.
              Rockcruit sent 4 candidates in 3 days. We hired one — he's still
              with us two years later.
            </p><div class="testi-author">
              <div class="testi-av">
                <span class="testi-initials">AL</span>
              </div><div>
                <div class="testi-name">A. Lopez</div><div class="testi-role">
                  CTO · Patagonian
                </div>
              </div>
            </div>
          </div>
          <div class="testi-card">
            <span class="testi-qmark">"</span><p class="testi-text">
              What I value most is that they push back when something doesn't
              feel right. They're not just closing placements — they actually
              care about the fit.
            </p><div class="testi-author">
              <div class="testi-av">
                <span class="testi-initials">JP</span>
              </div><div>
                <div class="testi-name">J. Pereyra</div><div class="testi-role">
                  Talent Acquisition · Hiberus
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="testi-controls">
        <button class="testi-btn" id="tPrev" aria-label="Previous testimonial"
          >←</button
        >
        <div class="testi-dots">
          <button class="testi-dot active" data-i="0" aria-label="Testimonial 1"
          ></button><button
            class="testi-dot"
            data-i="1"
            aria-label="Testimonial 2"></button><button
            class="testi-dot"
            data-i="2"
            aria-label="Testimonial 3"></button>
        </div>
        <button class="testi-btn" id="tNext" aria-label="Next testimonial"
          >→</button
        >
      </div>
    </div>
  </section>

  <!-- ═══════ FINAL CTA ═══════ -->
  <section class="final-cta" id="contact">
    <div class="fcta-inner">
      <div class="fcta-left reveal">
        <div class="fcta-eyebrow">Let's work together</div>
        <h2 class="fcta-h2">
          <span>YOUR TEAM IS</span>
          <span class="green">GROWING.</span>
          <span>LET'S BUILD</span>
          <span>HIRING TO</span>
          <span class="green">MATCH.</span>
        </h2>
      </div>
      <div class="fcta-right reveal">
        <p class="fcta-intro-p">
          Growth creates pressure on recruiting faster than most companies
          expect. We help scaling teams build hiring capacity without slowing
          down execution.
        </p>
        <HireForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Section CSS from prototype index.html, verbatim.
   NOT here (lives elsewhere): :root/resets/body/noise/.reveal/.label-tag (global.css),
   nav/footer (components), .fcta-form/.f-* (HireForm.astro). */

  /* HERO */
  .hero {
    min-height: 100vh;
    /* The bar grows by the top inset of the phone, so the first line of the
       page must move down by the same amount. */
    padding-top: calc(54px + env(safe-area-inset-top, 0px));
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--bdark);
    position: relative;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    bottom: -80px;
    right: -80px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: rgba(var(--green-rgb), 0.06);
    filter: blur(100px);
    pointer-events: none;
  }
  .hero-h1-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 5% 3rem;
  }
  h1 {
    font-family: var(--bebas);
    font-size: clamp(5.5rem, 13vw, 16rem);
    line-height: 0.86;
    letter-spacing: 0.01em;
    /* The headline reads as an image: no selection, no text cursor. */
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    cursor: default;
  }
  .hl-ink {
    display: block;
    color: var(--paper);
  }
  .hl-green {
    display: block;
    color: var(--green);
  }
  .hl-muted {
    display: block;
    color: rgba(240, 237, 227, 0.18);
  }
  .hero-eyebrow-row {
    padding: 2.5rem 5% 0;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .hero-eyebrow {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(240, 237, 227, 0.3);
  }
  .subhero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    padding: 4rem 5%;
    border-top: 1px solid var(--bdark);
    background: #0b0b0b;
  }
  .subhero-left {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .subhero-title {
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #e4e4e7;
  }
  .subhero-title strong {
    font-weight: 700;
    color: #fff;
  }
  .subhero-body {
    font-size: 0.95rem;
    line-height: 1.8;
    color: #a1a1aa;
    max-width: 440px;
  }
  .subhero-ctas {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    padding-top: 0.4rem;
  }
  .btn-ghost-sub {
    font-size: 0.88rem;
    color: #e4e4e7;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    padding: 0.85rem 2rem;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
  }
  .btn-ghost-sub:hover {
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }
  .subhero-right {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .subhero-prop {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }
  .subhero-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(var(--green-rgb), 0.1);
    border: 1px solid rgba(var(--green-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--green);
    flex-shrink: 0;
  }
  .subhero-prop-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #e4e4e7;
    margin-bottom: 0.25rem;
  }
  .subhero-prop-sub {
    font-size: 0.82rem;
    color: #71717a;
    line-height: 1.6;
  }
  .btn-primary {
    background: var(--green);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .btn-primary:hover {
    background: var(--green-light);
    transform: translateY(-2px);
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--bdark);
    margin-top: 3rem;
    background: #0b0b0b;
    overflow: hidden;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: 2.5rem 5%;
    border-right: 1px solid #27272a;
    text-align: center;
  }
  .stat-item:last-child {
    border-right: none;
  }
  .stat-item.featured {
    background: rgba(255, 255, 255, 0.03);
    border: none;
    border-right: 1px solid #27272a;
    position: relative;
  }
  .stat-item.featured::before {
    content: "";
    position: absolute;
    inset: 0;
    border-top: 1px solid rgba(var(--violet-rgb), 0.35);
    pointer-events: none;
  }
  .stat-num {
    font-family: var(--bebas);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    letter-spacing: 0.03em;
    line-height: 1;
    font-weight: 400;
  }
  .stat-num.g {
    color: var(--green);
  }
  .stat-num.v {
    color: var(--violet-light);
  }
  .stat-label {
    font-size: 0.82rem;
    color: #a1a1aa;
    line-height: 1.5;
  }

  /* LOGOS */
  .logos {
    overflow: hidden;
    border-bottom: 1px solid var(--bdark);
    padding: 1.5rem 0;
    background: rgba(255, 255, 255, 0.02);
  }
  .logos-label {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(240, 237, 227, 0.25);
    text-align: center;
    margin-bottom: 1.2rem;
  }
  .logos-track {
    display: flex;
    width: max-content;
    animation: mq 32s linear infinite;
  }
  @keyframes mq {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 2.5rem;
    height: 28px;
    border-right: 1px solid var(--bdark);
  }
  .logo-text {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--paper);
    opacity: 0.18;
    white-space: nowrap;
    transition: opacity 0.2s;
  }
  .logo-item:hover .logo-text {
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .logos-track {
      animation: none;
    }
  }

  /* POSITIONING */
  .positioning {

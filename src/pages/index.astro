  /* The mask makes a logo fade away at the two ends, in place of a hard cut. It uses
     the same values as `.domains-marquee` on the Team page. A mask color gives opacity
     only. It is not a color of the design. */
  .brands-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 min(90px, 15%),
      #000 calc(100% - min(90px, 15%)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 min(90px, 15%),
      #000 calc(100% - min(90px, 15%)),
      transparent 100%
    );
  }
  .brands-track {
    display: flex;
    width: max-content;
    animation: mq 32s linear infinite;

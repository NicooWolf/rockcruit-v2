<script>
  // Accordion — event delegation (survives ClientRouter navigations, never double-binds).
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest?.(".diff-item-btn");
    if (!btn) return;
    const item = btn.closest(".diff-item");
    const wasOpen = item?.classList.contains("open");
    document
      .querySelectorAll(".diff-item")
      .forEach((i) => i.classList.remove("open"));
    if (!wasOpen) item?.classList.add("open");
  });

  // Carousel — fresh state per page entry (astro:page-load pattern).
  document.addEventListener("astro:page-load", () => {
    const track = document.querySelector<HTMLElement>(".testi-track");
    if (!track) return;
    const cards = Array.from(
      track.querySelectorAll<HTMLElement>(".testi-card"),
    );
    const view = track.parentElement;
    const dots = document.querySelectorAll<HTMLButtonElement>(".testi-dot");
    const count = cards.length;
    if (!view || !count) return;
    let idx = 0;

    // The track moves by a whole number of pixels. A percentage move lands on
    // a fraction of a pixel, and the card border and the round corners smear.
    // The measurement also holds the gap between two cards.
    const stepOf = (i: number) =>
      Math.round(cards[i].offsetLeft - cards[0].offsetLeft);
    const move = (px: number) => {
      track.style.transform = px ? `translateX(${-Math.round(px)}px)` : "";
    };
    const place = () => move(stepOf(idx));

    const goTo = (i: number) => {
      idx = (i + count) % count;
      place();
      dots.forEach((d, j) => d.classList.toggle("active", j === idx));
    };

    document
      .getElementById("tNext")
      ?.addEventListener("click", () => goTo(idx + 1));
    document
      .getElementById("tPrev")
      ?.addEventListener("click", () => goTo(idx - 1));
    dots.forEach((d) =>
      d.addEventListener("click", () => goTo(Number(d.dataset.i))),
    );

    // ── Touch swipe.
    // A finger or a pen drags the track. A mouse does not: a mouse drag selects
    // the text of the card. CSS gives the browser the vertical direction with
    // touch-action: pan-y, so the page still scrolls under the finger.
    const SLOP = 10; // px, the movement that names the direction of the drag
    let pointer: number | null = null;
    let startX = 0;
    let startY = 0;
    let axis = "";

    view.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" || pointer !== null) return;
      pointer = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
      axis = "";
    });

    view.addEventListener("pointermove", (e) => {
      if (e.pointerId !== pointer) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (!axis) {
        if (Math.abs(dx) < SLOP && Math.abs(dy) < SLOP) return;
        axis = Math.abs(dx) > Math.abs(dy) ? "x" : "y";
        if (axis !== "x") return;
        track.style.transition = "none";
        view.setPointerCapture(e.pointerId);
      }
      if (axis !== "x") return;
      // The first card and the last card resist. The track holds no card
      // outside them, and a free drag shows an empty space.
      let px = stepOf(idx) - dx;
      const last = stepOf(count - 1);
      if (px < 0) px /= 3;
      else if (px > last) px = last + (px - last) / 3;
      move(px);
    });

    const endDrag = (e: PointerEvent) => {
      if (e.pointerId !== pointer) return;
      pointer = null;
      track.style.transition = "";
      if (axis !== "x") return;
      axis = "";
      const dx = e.clientX - startX;
      const trigger = Math.min(80, view.clientWidth * 0.2);
      // The swipe stops at the two ends. The arrows and the dots still turn
      // around, but a drag that resists must not jump to the other end.
      if (dx <= -trigger && idx < count - 1) goTo(idx + 1);
      else if (dx >= trigger && idx > 0) goTo(idx - 1);
      else place();
    };
    view.addEventListener("pointerup", endDrag);
    view.addEventListener("pointercancel", endDrag);

    // A resize changes the card width, and the old distance no longer fits.
    // Move the track at once, with no animation.
    const onResize = () => {
      track.style.transition = "none";
      place();
      void track.offsetWidth; // forces the reflow before the animation returns
      track.style.transition = "";
    };
    window.addEventListener("resize", onResize);
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("resize", onResize),
      { once: true },
    );
  });
</script>

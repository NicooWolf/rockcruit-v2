  }
  .st-card {
    background: var(--ink);
    padding: 3.5rem 5%;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    position: relative;
    overflow: hidden;
    /* This scoped rule beats the unscoped .slide-left/.slide-right rule in
       global.css on specificity (Astro adds a data-astro-cid attribute to
       every scoped selector), so the side-in reveal transition must live
       here too, or it silently loses the opacity/transform transition. */
    transition:
      background 0.2s,
      opacity 1.4s cubic-bezier(0.25, 1, 0.5, 1),
      transform 1.4s cubic-bezier(0.25, 1, 0.5, 1);
    transition-delay:
      0s, calc(var(--reveal-index, 0) * 100ms),
      calc(var(--reveal-index, 0) * 100ms);
  }
  .st-card:hover {
    background: rgba(255, 255, 255, 0.025);
  }
  .st-card::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s;

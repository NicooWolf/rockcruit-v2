  /* The window that hides the cards on both sides of the visible one. The
     padding holds the clip edge clear of the card border. The card border is
     1px wide, and the browser rounds the moved track to whole pixels, so a
     border on the clip edge disappears and the round corners look cut. The
     negative margin gives the space back, so the card still lines up with the
     heading above. */
  .testi-viewport {
    overflow: hidden;
    padding: 3px;
    margin: -3px;
    /* The browser keeps the vertical direction and gives the script the
       horizontal one. The page still scrolls under a finger on a card. */
    touch-action: pan-y;

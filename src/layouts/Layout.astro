---
// src/layouts/Layout.astro — the one HTML shell. Owns <head>, Nav, Footer,
// ClientRouter, the persisted cursor, and the two global scripts (cursor, reveals).
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Rockcruit offers IT recruiting services to companies in need of tech talent. Contact us to find the best candidates for your company and projects.",
} = Astro.props;

// Requires `site` in astro.config.mjs (Step 3.0); defensive so dev never crashes.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/rockcruit-lila-icon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital,wght@0,400;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body>
    <!-- transition:persist = this exact DOM node survives client-side navigations -->
    <Nav />
    <slot />
    <Footer />

    <script>
      // ── Scroll depth and the section hash.
      // A hash jump moves the page by itself. Only a move that the reader
      // makes may drop the hash, so the code waits for the jump to settle and
      // then for a real change of the scroll depth. Touch and mouse raise the
      // same scroll event, so one rule serves mobile and desktop.
      const END_ZONE = 8; // px, absorbs sub-pixel and elastic scroll values
      const SETTLE_TIME = 900; // ms, the wait for a jump to start
      const IDLE_TIME = 250; // ms without a scroll event ends a jump

      let settleUntil = 0;
      let landingDepth = 0;
      let readerMoved = false;

      const startJump = () => {
        settleUntil = performance.now() + SETTLE_TIME;
        landingDepth = window.scrollY;
        readerMoved = false;
      };

      // ClientRouter owns scroll restoration, so the browser does not jump to
      // the section on a reload. Do that jump here.
      document.addEventListener("astro:page-load", () => {
        startJump();

        const id = decodeURIComponent(window.location.hash.slice(1));
        if (!id) return;

        const target = document.getElementById(id);
        if (!target) return;

        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: "instant", block: "start" });
          startJump();
        });
      });

      // A click on a same-page link also jumps, and CSS makes that jump smooth.
      window.addEventListener("hashchange", startJump);

      const trimHashAtEnds = () => {
        if (!window.location.hash) return;

        const depth = window.scrollY;

        // The jump still runs: it owns every move, and it sets the landing.
        // A smooth jump takes many frames, so each move holds the jump open.
        const now = performance.now();
        if (now < settleUntil) {
          landingDepth = depth;
          settleUntil = Math.max(settleUntil, now + IDLE_TIME);
          return;
        }

        if (!readerMoved) {
          if (Math.abs(depth - landingDepth) <= END_ZONE) return;
          readerMoved = true;
        }

        const maxDepth =
          document.documentElement.scrollHeight - window.innerHeight;
        const atTop = depth <= END_ZONE;
        const atBottom = maxDepth - depth <= END_ZONE;
        if (!atTop && !atBottom) return;

        history.replaceState(
          history.state,
          "",
          window.location.pathname + window.location.search,
        );
      };

      let scrollPending = false;
      window.addEventListener(
        "scroll",
        () => {
          if (scrollPending) return;
          scrollPending = true;
          requestAnimationFrame(() => {
            scrollPending = false;
            trimHashAtEnds();
          });
        },
        { passive: true },
      );

      // ── Scroll reveals: fresh observer per page entry.
      // astro:page-load fires on initial load AND after every navigation.
      document.addEventListener("astro:page-load", () => {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry, i) => {
              if (entry.isIntersecting) {
                setTimeout(() => entry.target.classList.add("on"), i * 70);
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.06 },
        );
        document
          .querySelectorAll(".reveal:not(.on)")
          .forEach((el) => io.observe(el));
      });
    </script>
  </body>
</html>

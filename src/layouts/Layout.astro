---
// src/layouts/Layout.astro — the one HTML shell. Owns <head>, Nav, Footer,
// ClientRouter, the persisted cursor, and the two global scripts (cursor, reveals).
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { href } from "../lib/url";
import bebasUrl from "../assets/fonts/bebas-neue-400.woff2";
import dmSansUrl from "../assets/fonts/dm-sans.woff2";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Rockcruit offers IT recruiting services to companies in need of tech talent. Contact us to find the best candidates for your company and projects.",
} = Astro.props;

// Requires `site` in astro.config.mjs (Step 3.0); defensive so dev never crashes.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#141210" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="icon"
      type="image/svg+xml"
      href={href("/rockcruit-lila-icon.svg")}
    />

    <!-- The site self-hosts the fonts. See @font-face in global.css. Preload
         the two fonts that the reader sees first, so no grey swap happens. -->
    <link
      rel="preload"
      href={bebasUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={dmSansUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Above-The-Fold Reveal & WebKit View Transition Sync -->
    <script is:inline>
      (function () {
        let activeTransition = null;

        function revealATF(doc) {
          const vh = window.innerHeight;
          const els = doc.querySelectorAll(".reveal:not(.on)");
          let revealIndex = 0;
          for (let i = 0; i < els.length; i++) {
            const rect = els[i].getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < vh) {
              els[i].style.setProperty("--reveal-index", revealIndex);
              els[i].classList.add("on");
              revealIndex++;
            }
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            revealATF(document);
          });
        } else {
          revealATF(document);
        }

        document.addEventListener("astro:before-swap", function (event) {
          const transition = event.viewTransition;
          activeTransition = transition;

          const finishTransition = function () {
            if (activeTransition === transition) {
              activeTransition = null;
            }
            requestAnimationFrame(function () {
              document.dispatchEvent(
                new CustomEvent("rockcruit:transition-end"),
              );
            });
          };

          transition.finished.then(finishTransition, finishTransition);
        });

        function stopSnapshotForInteraction() {
          if (activeTransition) {
            activeTransition.skipTransition();
          }
        }

        window.addEventListener("touchstart", stopSnapshotForInteraction, {
          passive: true,
        });
        window.addEventListener("wheel", stopSnapshotForInteraction, {
          passive: true,
        });

        // Measure the live DOM after the swap and before the new snapshot.
        // The transition gate prevents reveal motion during this operation.
        document.addEventListener("astro:after-swap", function () {
          revealATF(document);

          // Force a WebKit compositor pass after the DOM swap.
          const root = document.documentElement;
          root.style.transform = "translateZ(0)";
          void root.offsetHeight;
          root.style.transform = "";
        });
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <!-- Safari fills its top bar with the color of a fixed element that touches
         the top edge of the window, and leaves the bar clear when it finds
         none. The nav leaves the top edge on the way down the page, so the nav
         cannot be that element. This strip never moves. See WebKit bug 301756. -->
    <div class="ios-tint" aria-hidden="true"></div>
    <!-- transition:persist = this exact DOM node survives client-side navigations -->
    <Nav />
    <slot />
    <Footer />

    <script>
      // ── Scroll depth and the section hash.
      const END_ZONE = 8; // px, absorbs sub-pixel and elastic scroll values
      const SETTLE_TIME = 900; // ms, the wait for a jump to start
      const IDLE_TIME = 250; // ms without a scroll event ends a jump

      let settleUntil = 0;
      let landingDepth = 0;
      let readerMoved = false;

      const startJump = () => {
        settleUntil = performance.now() + SETTLE_TIME;
        landingDepth = window.scrollY;
        readerMoved = false;
      };

      // ── Instant reveal for a jump target.
      const revealSection = (id: string) => {
        if (!id) return null;
        const target = document.getElementById(id);
        if (!target) return null;
        if (target.classList.contains("reveal")) target.classList.add("on");
        target
          .querySelectorAll(".reveal:not(.on)")
          .forEach((el) => el.classList.add("on"));
        return target;
      };

      // ClientRouter owns scroll restoration, so the browser does not jump to
      // the section on a reload. Do that jump here.
      document.addEventListener("astro:page-load", () => {
        startJump();

        const id = decodeURIComponent(window.location.hash.slice(1));
        if (!id) return;

        const target = revealSection(id);
        if (!target) return;

        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: "instant", block: "start" });
          startJump();
        });
      });

      // Intercept same-page hash links for instant rendered jumps.
      document.addEventListener("click", (event) => {
        if (event.defaultPrevented) return;
        if (
          event.button ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;

        const link = (event.target as Element)?.closest?.(
          "a[href]",
        ) as HTMLAnchorElement | null;
        if (!link || link.target === "_blank") return;

        let url: URL;
        try {
          url = new URL(link.href);
        } catch {
          return;
        }
        if (url.origin !== window.location.origin) return;
        if (url.pathname !== window.location.pathname) return; // cross-page: let router handle
        if (url.search !== window.location.search) return;

        if (!url.hash || url.hash === "#") {
          event.preventDefault();
          if (window.location.hash) {
            history.pushState(history.state, "", url.pathname + url.search);
          }
          window.scrollTo({ top: 0, left: 0, behavior: "instant" });
          startJump();
          return;
        }

        const id = decodeURIComponent(url.hash.slice(1));
        const target = revealSection(id);
        if (!target) return;

        event.preventDefault();
        if (window.location.hash !== url.hash) {
          history.pushState(
            history.state,
            "",
            url.pathname + url.search + url.hash,
          );
        }
        target.scrollIntoView({ behavior: "instant", block: "start" });
        startJump();
      });

      window.addEventListener("hashchange", () => {
        revealSection(decodeURIComponent(window.location.hash.slice(1)));
        startJump();
      });

      const trimHashAtEnds = () => {
        if (!window.location.hash) return;

        const depth = window.scrollY;

        const now = performance.now();
        if (now < settleUntil) {
          landingDepth = depth;
          settleUntil = Math.max(settleUntil, now + IDLE_TIME);
          return;
        }

        if (!readerMoved) {
          if (Math.abs(depth - landingDepth) <= END_ZONE) return;
          readerMoved = true;
        }

        const maxDepth =
          document.documentElement.scrollHeight - window.innerHeight;
        const atTop = depth <= END_ZONE;
        const atBottom = maxDepth - depth <= END_ZONE;
        if (!atTop && !atBottom) return;

        history.replaceState(
          history.state,
          "",
          window.location.pathname + window.location.search,
        );
      };

      let scrollPending = false;
      window.addEventListener(
        "scroll",
        () => {
          if (scrollPending) return;
          scrollPending = true;
          requestAnimationFrame(() => {
            scrollPending = false;
            trimHashAtEnds();
          });
        },
        { passive: true },
      );

      // ── Below-The-Fold Scroll reveals: fresh observer per page entry.
      document.addEventListener("astro:page-load", () => {
        const io = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort(
                (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
              );

            visible.forEach((entry) => {
              io.unobserve(entry.target);
            });

            const revealVisible = () => {
              visible.forEach((entry, i) => {
                (entry.target as HTMLElement).style.setProperty(
                  "--reveal-index",
                  String(i),
                );
                entry.target.classList.add("on");
              });
            };

            if (
              document.documentElement.hasAttribute("data-astro-transition")
            ) {
              document.addEventListener(
                "rockcruit:transition-end",
                revealVisible,
                { once: true },
              );
            } else {
              revealVisible();
            }
          },
          { threshold: 0.08, rootMargin: "0px 0px -8% 0px" },
        );
        document
          .querySelectorAll(".reveal:not(.on)")
          .forEach((el) => io.observe(el));
      });
    </script>
  </body>
</html>

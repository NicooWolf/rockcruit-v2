---
// src/layouts/Layout.astro — the one HTML shell. Owns <head>, Nav, Footer,
// ClientRouter, the persisted cursor, and the two global scripts (cursor, reveals).
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { href } from "../lib/url";
import bebasUrl from "../assets/fonts/bebas-neue-400.woff2";
import dmSansUrl from "../assets/fonts/dm-sans.woff2";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Rockcruit offers IT recruiting services to companies in need of tech talent. Contact us to find the best candidates for your company and projects.",
} = Astro.props;

// Requires `site` in astro.config.mjs (Step 3.0); defensive so dev never crashes.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#141210" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="icon"
      type="image/svg+xml"
      href={href("/rockcruit-lila-icon.svg")}
    />

    <!-- The site self-hosts the fonts. See @font-face in global.css. Preload
         the two fonts that the reader sees first, so no grey swap happens. -->
    <link
      rel="preload"
      href={bebasUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={dmSansUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Show the first screen at once.
         A .reveal element hides at opacity 0 until the observer below adds
         .on. The observer runs from a deferred module. On a phone that
         module loads late, so the first screen stayed grey for about one
         second, on load and after every navigation. This inline script runs
         early. It shows the elements that the reader sees first. The observer
         still animates the rest of the page on scroll.
         astro:after-swap fires right after a navigation swaps the DOM and
         before the new page paints, so the logo link no longer flashes grey. -->
    <script is:inline>
      (function () {
        function revealInView() {
          var vh = window.innerHeight;
          var els = document.querySelectorAll(".reveal:not(.on)");
          for (var i = 0; i < els.length; i++) {
            if (els[i].getBoundingClientRect().top < vh) {
              els[i].classList.add("on");
            }
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", revealInView);
        } else {
          revealInView();
        }
        document.addEventListener("astro:after-swap", revealInView);
      })();
    </script>

    <ClientRouter />

    <script is:inline>
      (function () {
        function revealInDoc(doc) {
          var vh = window.innerHeight;
          var els = doc.querySelectorAll(".reveal:not(.on)");
          for (var i = 0; i < els.length; i++) {
            if (els[i].getBoundingClientRect().top < vh) {
              els[i].classList.add("on");
            }
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            revealInDoc(document);
          });
        } else {
          revealInDoc(document);
        }

        // Mutate incoming DOM tree BEFORE snapshot generation
        document.addEventListener("astro:before-swap", function (e) {
          revealInDoc(e.newDocument);
        });
      })();
    </script>
  </head>
  <body>
    <!-- Safari fills its top bar with the color of a fixed element that touches
         the top edge of the window, and leaves the bar clear when it finds
         none. The nav leaves the top edge on the way down the page, so the nav
         cannot be that element. This strip never moves. See WebKit bug 301756. -->
    <div class="ios-tint" aria-hidden="true"></div>
    <!-- transition:persist = this exact DOM node survives client-side navigations -->
    <Nav />
    <slot />
    <Footer />

    <script>
      // ── Scroll depth and the section hash.
      // A hash jump moves the page by itself. Only a move that the reader
      // makes may drop the hash, so the code waits for the jump to settle and
      // then for a real change of the scroll depth. Touch and mouse raise the
      // same scroll event, so one rule serves mobile and desktop.
      const END_ZONE = 8; // px, absorbs sub-pixel and elastic scroll values
      const SETTLE_TIME = 900; // ms, the wait for a jump to start
      const IDLE_TIME = 250; // ms without a scroll event ends a jump

      let settleUntil = 0;
      let landingDepth = 0;
      let readerMoved = false;

      const startJump = () => {
        settleUntil = performance.now() + SETTLE_TIME;
        landingDepth = window.scrollY;
        readerMoved = false;
      };

      // ── Instant reveal for a jump target.
      // A .reveal element sits at opacity 0 until the IntersectionObserver
      // adds .on, and the observer only fires once the scroll reaches it. A
      // jump to a far section (e.g. /#contact from the top of a long page)
      // therefore left its text and form blank until the scroll arrived —
      // seconds later. When a section is the jump target, show its content
      // now, so it renders the instant we land rather than at scroll's end.
      const revealSection = (id: string) => {
        if (!id) return null;
        const target = document.getElementById(id);
        if (!target) return null;
        if (target.classList.contains("reveal")) target.classList.add("on");
        target
          .querySelectorAll(".reveal:not(.on)")
          .forEach((el) => el.classList.add("on"));
        return target;
      };

      // ClientRouter owns scroll restoration, so the browser does not jump to
      // the section on a reload. Do that jump here.
      document.addEventListener("astro:page-load", () => {
        startJump();

        const id = decodeURIComponent(window.location.hash.slice(1));
        if (!id) return;

        const target = revealSection(id);
        if (!target) return;

        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: "instant", block: "start" });
          startJump();
        });
      });

      // Same-page hash links (the CTAs, "Hire With Us", "Open Positions") are
      // plain anchors: the browser jumps natively and CSS scroll-behavior makes
      // that a multi-second smooth glide down the page, with the target only
      // revealing at the end. Intercept them — reveal the target and jump to it
      // instantly — so any navigation lands rendered in one frame.
      document.addEventListener("click", (event) => {
        if (event.defaultPrevented) return;
        if (
          event.button ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;

        const link = (event.target as Element)?.closest?.(
          "a[href]",
        ) as HTMLAnchorElement | null;
        if (!link || link.target === "_blank") return;

        let url: URL;
        try {
          url = new URL(link.href);
        } catch {
          return;
        }
        if (url.origin !== window.location.origin) return;
        if (url.pathname !== window.location.pathname) return; // cross-page: let the router handle it
        if (!url.hash || url.hash === "#") return;

        const id = decodeURIComponent(url.hash.slice(1));
        const target = revealSection(id);
        if (!target) return;

        event.preventDefault();
        if (window.location.hash !== url.hash) {
          history.pushState(
            history.state,
            "",
            url.pathname + url.search + url.hash,
          );
        }
        target.scrollIntoView({ behavior: "instant", block: "start" });
        startJump();
      });

      // A click on a same-page link also jumps, and CSS makes that jump smooth.
      window.addEventListener("hashchange", () => {
        revealSection(decodeURIComponent(window.location.hash.slice(1)));
        startJump();
      });

      const trimHashAtEnds = () => {
        if (!window.location.hash) return;

        const depth = window.scrollY;

        // The jump still runs: it owns every move, and it sets the landing.
        // A smooth jump takes many frames, so each move holds the jump open.
        const now = performance.now();
        if (now < settleUntil) {
          landingDepth = depth;
          settleUntil = Math.max(settleUntil, now + IDLE_TIME);
          return;
        }

        if (!readerMoved) {
          if (Math.abs(depth - landingDepth) <= END_ZONE) return;
          readerMoved = true;
        }

        const maxDepth =
          document.documentElement.scrollHeight - window.innerHeight;
        const atTop = depth <= END_ZONE;
        const atBottom = maxDepth - depth <= END_ZONE;
        if (!atTop && !atBottom) return;

        history.replaceState(
          history.state,
          "",
          window.location.pathname + window.location.search,
        );
      };

      let scrollPending = false;
      window.addEventListener(
        "scroll",
        () => {
          if (scrollPending) return;
          scrollPending = true;
          requestAnimationFrame(() => {
            scrollPending = false;
            trimHashAtEnds();
          });
        },
        { passive: true },
      );

      // ── Scroll reveals: fresh observer per page entry.
      // astro:page-load fires on initial load AND after every navigation.
      document.addEventListener("astro:page-load", () => {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry, i) => {
              if (entry.isIntersecting) {
                setTimeout(() => entry.target.classList.add("on"), i * 70);
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.06 },
        );
        document
          .querySelectorAll(".reveal:not(.on)")
          .forEach((el) => io.observe(el));
      });
    </script>
  </body>
</html>

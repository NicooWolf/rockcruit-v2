---
// src/components/BlogStage.astro — the featured post stage on the blog page.
// It shows up to three posts. One post is featured: its image is the
// backdrop and its title is the headline. The two other posts sit in the
// side slots. A click on a slot makes that post the featured post.
// All posts are in the DOM. The script toggles classes and attributes only.
import { href } from "../lib/url";
import type { Post } from "../lib/wp";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

// WordPress sends titles and excerpts with HTML entities. Astro escapes text,
// so decode the common entities before output.
const NAMED: Record<string, string> = {
  amp: "&",
  quot: '"',
  apos: "'",
  lt: "<",
  gt: ">",
  nbsp: " ",
  hellip: "…",
  ndash: "–",
  mdash: "—",
  lsquo: "‘",
  rsquo: "’",
  ldquo: "“",
  rdquo: "”",
};
const decode = (s: string) =>
  s
    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16)))
    .replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)))
    .replace(/&([a-z]+);/gi, (m, n) => NAMED[n.toLowerCase()] ?? m);

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-US", { dateStyle: "medium" });

const items = posts.slice(0, 3).map((post) => {
  const f = post.postFields;
  // The author relation returns a list. Take the first author.
  const author = f?.author?.nodes?.[0]?.authorFields;
  const authorName = [author?.name, author?.lastName].filter(Boolean).join(" ");
  const lede =
    f?.description?.trim() ||
    decode(post.excerpt.replace(/<[^>]+>/g, "")).trim();
  return {
    slug: post.slug,
    title: decode(post.title),
    url: href(`/blog/${post.slug}/`),
    image: f?.postImage?.node?.sourceUrl ?? "",
    lede,
    date: post.date,
    meta: [
      fmt(post.date),
      f?.readingTime ? `${f.readingTime} min read` : "",
      authorName,
    ].filter(Boolean),
  };
});

// Initial slot state. Two posts: the right slot only. Three posts: both.
const rest = items.slice(1);
const [left, right] = rest.length === 1 ? [undefined, rest[0]] : rest;
const slots = [
  { side: "l", item: left },
  { side: "r", item: right },
] as const;
---

<section class="blog-stage" aria-label="Featured posts">
  <div class="stage-sky" aria-hidden="true">
    {
      items.map((item, i) =>
        item.image ? (
          <img
            class:list={["sky-img", { "is-active": i === 0 }]}
            data-slug={item.slug}
            src={item.image}
            alt=""
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
            decoding="async"
          />
        ) : (
          <div
            class:list={["sky-img", "sky-fallback", { "is-active": i === 0 }]}
            data-slug={item.slug}
          />
        ),
      )
    }
    <div class="stage-scrim"></div>
  </div>

  <h1 class="visually-hidden">Hiring, written down.</h1>

  <div class="stage-copy">
    <p class="stage-eyebrow mask-line">
      <span class="mask-inner">Notes from the field</span>
    </p>

    <div class="stage-posts" aria-live="polite">
      {
        items.map((item, i) => (
          <article
            class:list={["stage-post", { "is-featured": i === 0 }]}
            data-slug={item.slug}
            data-title={item.title}
            hidden={i !== 0}
            inert={i !== 0}
          >
            <h2 class:list={["stage-title", { "mask-line": i === 0 }]}>
              <a
                class:list={["stage-title-link", { "mask-inner": i === 0 }]}
                href={item.url}
              >
                <span class="stage-title-text">{item.title}</span>
              </a>
            </h2>
            <div class="stage-rule" aria-hidden="true">
              <span />
            </div>
            {item.lede && (
              <p class:list={["stage-lede", { reveal: i === 0 }]}>
                {item.lede}
              </p>
            )}
            {item.meta.length > 0 && (
              <p class:list={["stage-meta", { reveal: i === 0 }]}>
                <time datetime={item.date}>{item.meta[0]}</time>
                {item.meta.slice(1).map((part) => (
                  <span> · {part}</span>
                ))}
              </p>
            )}
          </article>
        ))
      }
    </div>

    <div class="stage-row">
      <div class="stage-cta-wrap reveal">
        {
          items.map((item, i) => (
            <a
              class="stage-cta"
              href={item.url}
              data-slug={item.slug}
              hidden={i !== 0}
            >
              Read more →
            </a>
          ))
        }
      </div>

      {
        items.length > 1 &&
          slots.map(({ side, item }) => (
            <>
              <button
                class:list={["stage-slot", `slot-${side}`]}
                type="button"
                data-slot={side}
                data-slug={item?.slug}
                aria-label={item ? `Show post: ${item.title}` : undefined}
                hidden={!item}
              >
                {items.map((entry) =>
                  entry.image ? (
                    <img
                      class:list={{ "is-shown": entry.slug === item?.slug }}
                      data-slug={entry.slug}
                      src={entry.image}
                      alt=""
                      decoding="async"
                    />
                  ) : (
                    <span
                      class:list={[
                        "slot-fallback",
                        { "is-shown": entry.slug === item?.slug },
                      ]}
                      data-slug={entry.slug}
                    />
                  ),
                )}
              </button>
              <span
                class:list={["slot-label", `label-${side}`, "reveal"]}
                hidden={!item}
              >
                {item?.title}
              </span>
            </>
          ))
      }
    </div>
  </div>

  <a class="stage-scroll reveal" href="#posts" aria-label="Scroll to all posts">
    <svg viewBox="0 0 26 33" fill="none" aria-hidden="true">
      <path
        d="M13 1.5 V31.5 M1.9 20.4 L13 31.5 L24.1 20.4"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="square"
        stroke-linejoin="miter"></path>
    </svg>
  </a>
</section>

<style>
  /* One design pixel = 1u. Every length below is calc(N * var(--u)), except
     the nav clearance and the 1px hairlines. The unit stays in this block,
     so the rest of the site keeps its own sizes. */
  .blog-stage {
    --u: max(
      min(0.72px, calc(100svh / 700)),
      min(calc(100vw / 1353), calc(100svh / 1163))
    );
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    /* The Nav is fixed. This padding keeps the copy below it. */
    padding-top: calc(54px + env(safe-area-inset-top, 0px));
    overflow: clip;
    isolation: isolate;
    border-bottom: 1px solid var(--bdark);
    background: var(--bg-base);
    color: var(--paper);
    font-family: var(--sans);
    /* The four brand fonts load only the faces in global.css. This line stops
       a faux bold or a faux italic. */
    font-synthesis: none;
  }
  /* A display rule below must not show an element that the script hides. */
  .blog-stage [hidden] {
    display: none !important;
  }

  /* ── Backdrop ── */
  .stage-sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* The backdrop fades. It does not move: a moving layer shows a bare edge. */
    animation: stage-fade 1.4s cubic-bezier(0.4, 0, 0.2, 1) 0.25s backwards;
  }
  .sky-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s linear;
  }
  .sky-img.is-active {
    opacity: 1;
  }
  .sky-fallback {
    background:
      radial-gradient(
        circle at 85% 10%,
        rgba(var(--green-rgb), 0.08),
        transparent 45%
      ),
      var(--bg-surface);
  }
  .stage-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 60% 55% at 50% 50%,
        color-mix(in srgb, var(--bg-base) 55%, transparent),
        transparent
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg-base) 80%, transparent) 0%,
        color-mix(in srgb, var(--bg-base) 55%, transparent) 50%,
        color-mix(in srgb, var(--bg-base) 92%, transparent) 100%
      );
  }

  /* ── Copy column ── */
  .stage-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* The bottom padding keeps the copy clear of the scroll control. */
    padding: calc(64 * var(--u)) 0 calc(180 * var(--u));
  }
  .stage-eyebrow {
    padding: 0 calc(26 * var(--u));
    font-family: var(--mono);
    font-weight: 400;
    font-size: calc(13 * var(--u));
    letter-spacing: calc(2 * var(--u));
    text-transform: uppercase;
    color: var(--green);
  }
  .stage-posts {
    width: 100%;
    padding: 0 calc(60 * var(--u));
  }
  .stage-post {
    max-width: calc(1000 * var(--u));
    margin: 0 auto;
  }
  /* A switched post fades in. It does not replay the entrance. */
  .blog-stage[data-switched] .stage-post.is-featured {
    animation: stage-fade 0.25s linear;
  }

  .stage-title {
    margin-top: calc(22 * var(--u));
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: calc(92 * var(--u));
    line-height: 0.98;
    letter-spacing: calc(-1.5 * var(--u));
    color: var(--paper);
  }
  .stage-title-link {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .stage-title-text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* The mask clips the line box. This padding keeps the italic descenders. */
    padding-bottom: 0.08em;
  }

  .stage-rule {
    margin-top: calc(28 * var(--u));
    height: calc(4 * var(--u));
    line-height: 0;
  }
  .stage-rule span {
    display: inline-block;
    width: calc(100 * var(--u));
    height: 100%;
    border-radius: calc(2 * var(--u));
    background: var(--green);
  }
  .blog-stage:not([data-switched]) .stage-post:first-child .stage-rule span {
    animation: stage-draw 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.6s backwards;
  }

  .stage-lede {
    max-width: calc(620 * var(--u));
    margin: calc(26 * var(--u)) auto 0;
    font-size: calc(18 * var(--u));
    font-weight: 400;
    line-height: calc(30 * var(--u));
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .stage-meta {
    margin-top: calc(18 * var(--u));
    font-family: var(--mono);
    font-weight: 400;
    font-size: calc(11 * var(--u));
    letter-spacing: calc(1 * var(--u));
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 35%, transparent);
  }

  /* ── CTA row: slot, label, button, label, slot ──
     The row spans the full stage width. The stage clips the slots at the
     screen edges. */
  .stage-row {
    position: relative;
    width: 100%;
    height: calc(60 * var(--u));
    margin-top: calc(36 * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .stage-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(216 * var(--u));
    height: calc(60 * var(--u));
    border-radius: 4px;
    background: var(--green);
    color: var(--ink);
    font-family: var(--sans);
    font-size: calc(15 * var(--u));
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s;
  }

  .stage-slot {
    position: absolute;
    top: 50%;
    z-index: 1;
    width: calc(180 * var(--u));
    height: calc(180 * var(--u));
    margin-top: calc(-90 * var(--u));
    padding: 0;
    border: 1px solid var(--bdark);
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-card);
    -webkit-appearance: none;
    appearance: none;
    line-height: 0;
    cursor: pointer;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s;
  }
  .blog-stage:not([data-switched]) .stage-slot {
    animation: stage-settle 0.7s cubic-bezier(0.22, 1, 0.36, 1) 1s backwards;
  }
  .slot-l {
    left: calc(-70 * var(--u));
  }
  .slot-r {
    right: calc(-65 * var(--u));
  }
  .stage-slot > * {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stage-slot > .is-shown {
    display: block;
  }
  .slot-fallback {
    background: radial-gradient(
      circle at 50% 35%,
      rgba(var(--green-rgb), 0.12),
      transparent 70%
    );
  }
  .stage-slot:active {
    transform: scale(0.99);
  }

  .slot-label {
    position: absolute;
    top: 0;
    /* The label must not reach the button. */
    max-width: min(calc(240 * var(--u)), calc(50% - 256 * var(--u)));
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: calc(18 * var(--u));
    line-height: calc(60 * var(--u));
    color: var(--paper);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .label-l {
    left: calc(128 * var(--u));
    text-align: left;
  }
  .label-r {
    right: calc(128 * var(--u));
    text-align: right;
  }

  /* ── Scroll control ── */
  .stage-scroll {
    position: absolute;
    left: 50%;
    bottom: calc(48 * var(--u));
    z-index: 2;
    width: calc(72 * var(--u));
    height: calc(72 * var(--u));
    margin-left: calc(-36 * var(--u));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--paper);
    background: color-mix(in srgb, var(--bg-surface) 70%, transparent);
    -webkit-backdrop-filter: blur(calc(6 * var(--u)));
    backdrop-filter: blur(calc(6 * var(--u)));
    transition: color 0.2s;
  }
  .stage-scroll svg {
    display: block;
    width: calc(16 * var(--u));
    height: calc(20 * var(--u));
  }

  @media (hover: hover) {
    .stage-title-link:hover {
      color: var(--green);
    }
    .stage-cta:hover {
      background: var(--green-light);
      transform: translateY(-2px);
    }
    .stage-slot:hover {
      transform: scale(1.045);
      border-color: rgba(var(--green-rgb), 0.5);
    }
    .stage-scroll:hover {
      color: var(--green);
    }
  }

  .blog-stage a:focus-visible,
  .blog-stage button:focus-visible {
    outline: calc(2 * var(--u)) solid var(--green);
    outline-offset: calc(3 * var(--u));
  }
  .blog-stage .stage-slot:focus-visible {
    outline-offset: calc(6 * var(--u));
  }

  /* ── A) Tablet ── */
  @media (min-width: 580px) and (max-width: 1030px) and (min-height: 621px) {
    .blog-stage {
      --u: min(
        max(
          min(0.85px, calc(100svh / 780)),
          min(calc(100vw / 900), calc(100svh / 1163))
        ),
        1.15px
      );
    }
    .stage-title {
      font-size: calc(80 * var(--u));
    }
    .stage-lede {
      max-width: calc(560 * var(--u));
    }
  }

  /* ── B) Phone ── */
  @media (max-width: 579px), (max-height: 620px) {
    .blog-stage {
      --u: max(
        min(0.92px, calc(100svh / 620)),
        min(calc(100vw / 430), calc(100svh / 880))
      );
    }
    .stage-copy {
      padding: calc(48 * var(--u)) 0 calc(140 * var(--u));
    }
    .stage-eyebrow {
      font-size: calc(12 * var(--u));
    }
    .stage-posts {
      padding: 0 calc(26 * var(--u));
    }
    .stage-title {
      font-size: calc(52 * var(--u));
      letter-spacing: calc(-0.8 * var(--u));
    }
    .stage-title-text {
      -webkit-line-clamp: 4;
    }
    .stage-rule span {
      width: calc(84 * var(--u));
    }
    .stage-lede {
      font-size: calc(15.5 * var(--u));
      line-height: calc(26 * var(--u));
      text-wrap: balance;
    }
    .stage-row {
      height: calc(54 * var(--u));
      margin-top: calc(32 * var(--u));
    }
    .stage-cta {
      width: calc(190 * var(--u));
      height: calc(54 * var(--u));
    }
    .stage-slot {
      width: calc(110 * var(--u));
      height: calc(110 * var(--u));
      margin-top: calc(-55 * var(--u));
    }
    .slot-l {
      left: calc(-55 * var(--u));
    }
    .slot-r {
      right: calc(-55 * var(--u));
    }
    .slot-label {
      font-size: calc(15 * var(--u));
      line-height: calc(54 * var(--u));
      max-width: min(calc(240 * var(--u)), calc(50% - 175 * var(--u)));
    }
    .label-l {
      left: calc(66 * var(--u));
    }
    .label-r {
      right: calc(66 * var(--u));
    }
    .stage-scroll {
      width: calc(60 * var(--u));
      height: calc(60 * var(--u));
      margin-left: calc(-30 * var(--u));
      bottom: calc(36 * var(--u));
    }
  }

  /* ── C) No room for the scroll control ── */
  @media (max-height: 660px) {
    .stage-scroll {
      display: none;
    }
    .stage-copy {
      padding-bottom: calc(48 * var(--u));
    }
  }

  /* ── D) Short ── */
  @media (max-height: 620px) {
    .blog-stage {
      --u: max(
        min(0.85px, calc(100svh / 470)),
        min(calc(100vw / 640), calc(100svh / 560))
      );
    }
    .stage-copy {
      padding-top: calc(24 * var(--u));
    }
    .stage-title {
      margin-top: calc(11 * var(--u));
      font-size: calc(44 * var(--u));
    }
    .stage-title-text {
      -webkit-line-clamp: 2;
    }
    .stage-rule {
      margin-top: calc(14 * var(--u));
    }
    .stage-lede {
      margin-top: calc(13 * var(--u));
    }
    .stage-meta {
      display: none;
    }
    .stage-row {
      margin-top: calc(18 * var(--u));
    }
  }

  /* ── E) Narrow — last, so it wins over D ──
     The phone frame is 430u wide at every phone width. The label / button /
     label row does not fit on one line, so the labels go to a band below
     the button. */
  @media (max-width: 579px) {
    .stage-row {
      margin-bottom: calc(64 * var(--u));
    }
    .slot-label {
      top: calc(100% + 36 * var(--u));
      max-width: 45%;
      line-height: 1.3;
    }
    .label-l {
      left: calc(6 * var(--u));
    }
    .label-r {
      right: calc(6 * var(--u));
    }
  }

  @keyframes stage-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes stage-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes stage-settle {
    from {
      opacity: 0;
      transform: translateY(calc(8 * var(--u))) scale(0.965);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-sky,
    .stage-post,
    .stage-rule span,
    .stage-slot {
      animation: none !important;
    }
    .sky-img,
    .stage-slot,
    .stage-cta,
    .stage-title-link,
    .stage-scroll {
      transition: none;
    }
    .stage-slot:hover,
    .stage-slot:active,
    .stage-cta:hover {
      transform: none;
    }
  }
</style>

<script>
  // Featured post switcher. It toggles classes and attributes only. It never
  // changes img.src: every image is already in the DOM.
  document.addEventListener("astro:page-load", () => {
    const stage = document.querySelector<HTMLElement>(".blog-stage");
    if (!stage || stage.dataset.bound) return;
    stage.dataset.bound = "true";

    // The scroll control works with any post count. The handler runs before
    // the Layout hash handler and replaces its instant jump.
    stage
      .querySelector<HTMLAnchorElement>(".stage-scroll")
      ?.addEventListener("click", (event) => {
        const target = document.getElementById("posts");
        if (!target) return;
        event.preventDefault();
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        target.scrollIntoView({
          behavior: reduce ? "instant" : "smooth",
          block: "start",
        });
      });

    const skies = Array.from(stage.querySelectorAll<HTMLElement>(".sky-img"));
    const order = skies.map((el) => el.dataset.slug ?? "");
    if (order.length < 2) return;

    const posts = Array.from(
      stage.querySelectorAll<HTMLElement>(".stage-post"),
    );
    const ctas = Array.from(stage.querySelectorAll<HTMLElement>(".stage-cta"));
    const titles = new Map(
      posts.map((el) => [el.dataset.slug ?? "", el.dataset.title ?? ""]),
    );
    const sides = (["l", "r"] as const).map((side) => ({
      slot: stage.querySelector<HTMLButtonElement>(`.slot-${side}`),
      label: stage.querySelector<HTMLElement>(`.label-${side}`),
    }));

    let featured = "";

    const fill = (
      { slot, label }: (typeof sides)[number],
      slug: string | undefined,
    ) => {
      if (!slot || !label) return;
      slot.hidden = !slug;
      label.hidden = !slug;
      if (!slug) return;
      const title = titles.get(slug) ?? "";
      slot.dataset.slug = slug;
      slot.setAttribute("aria-label", `Show post: ${title}`);
      slot
        .querySelectorAll<HTMLElement>("[data-slug]")
        .forEach((el) =>
          el.classList.toggle("is-shown", el.dataset.slug === slug),
        );
      label.textContent = title;
    };

    const render = (slug: string) => {
      featured = slug;
      skies.forEach((el) =>
        el.classList.toggle("is-active", el.dataset.slug === slug),
      );
      posts.forEach((el) => {
        const on = el.dataset.slug === slug;
        el.classList.toggle("is-featured", on);
        el.hidden = !on;
        el.inert = !on;
      });
      ctas.forEach((el) => {
        el.hidden = el.dataset.slug !== slug;
      });
      // Two posts: the right slot only. Three posts: both slots.
      const rest = order.filter((s) => s !== slug);
      const [l, r] = rest.length === 1 ? [undefined, rest[0]] : rest;
      fill(sides[0], l);
      fill(sides[1], r);
    };

    const show = (slug: string) => {
      if (!order.includes(slug) || slug === featured) return;
      stage.dataset.switched = "true";
      render(slug);
    };

    // Decode the backdrop on intent, so the crossfade shows a ready image.
    const warm = (slug: string | undefined) => {
      const sky = skies.find((el) => el.dataset.slug === slug);
      if (sky instanceof HTMLImageElement) sky.decode().catch(() => {});
    };

    sides.forEach(({ slot }) => {
      if (!slot) return;
      slot.addEventListener("click", () => show(slot.dataset.slug ?? ""));
      slot.addEventListener("pointerenter", () => warm(slot.dataset.slug));
      slot.addEventListener("focus", () => warm(slot.dataset.slug));
    });

    // After the first paint, load the other backdrops.
    const loadAll = () =>
      skies.forEach((el) => {
        if (el instanceof HTMLImageElement) el.loading = "eager";
      });
    if ("requestIdleCallback" in window)
      requestIdleCallback(loadAll, { timeout: 4000 });
    else setTimeout(loadAll, 2500);

    render(order[0]);
  });
</script>

---
// src/components/Footer.astro
import { href } from "../lib/url";
import RockcruitWordmark from "../assets/icons/rockcruit-white-title.svg";
import InstagramIcon from "../assets/icons/instagram-icon.svg";
import LinkedinIcon from "../assets/icons/linkedin-icon.svg";
import MailIcon from "../assets/icons/mail-icon.svg";

const year = new Date().getFullYear(); // computed at build time — never stale
---

<footer>
  <a href={href("/")} class="foot-logo">
    <!-- The width and the height give the size before the style applies. They
         must hold the same values as .foot-mark. -->
    <RockcruitWordmark
      class="foot-mark"
      width="111"
      height="13"
      role="img"
      aria-label="Rockcruit"
    />
    <div class="foot-dot"></div>
  </a>
  <ul class="foot-links">
    <li><a href={href("/services")}>Services</a></li>
    <li><a href={href("/faq")}>FAQ</a></li>
    <li><a href={href("/#contact")}>Hire With Us</a></li>
    <li class="foot-social">
      <a
        href="https://www.instagram.com/rockcruit/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <InstagramIcon width="18" height="18" role="img" aria-hidden="true" />
      </a>
      <a
        href="https://www.linkedin.com/company/rockcruit"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        <LinkedinIcon width="18" height="18" role="img" aria-hidden="true" />
      </a>
      <a href="mailto:info@rockcruit.com" aria-label="Mail">
        <MailIcon width="18" height="18" role="img" aria-hidden="true" />
      </a>
    </li>
  </ul>
  <div class="foot-copy">© {year} Rockcruit · All rights reserved</div>
</footer>

<style>
  footer {
    padding: 2.5rem 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    border-top: 1px solid var(--bdark);
  }
  .foot-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  /* The same mark as the bar, and a little smaller. The old word held 1.3rem
     against the 1.6rem of the bar. --logo-height keeps that relation.
     The width comes from the ratio of the file, 209 to 24. Do not use
     width:auto. An automatic width lets the browser take the 209px size of the
     file, and the mark then grows after a client-side navigation. */
  .foot-mark {
    --logo-height: 0.8rem;
    display: block;
    height: var(--logo-height);
    width: calc(var(--logo-height) * 209 / 24);
    flex: none;
  }
  .foot-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
  }
  .foot-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }
  .foot-links a {
    font-size: 0.77rem;
    color: rgba(240, 237, 227, 0.35);
    text-decoration: none;
    transition: color 0.2s;
  }
  .foot-links a:hover {
    color: var(--paper);
  }
  .foot-social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  /* The icon files hold a fixed white fill. The opacity gives the muted state
     of the text links, and the hover gives the full paper color. */
  .foot-social a {
    display: flex;
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .foot-social a:hover {
    opacity: 1;
  }
  .foot-social svg {
    display: block;
  }
  .foot-copy {
    font-size: 0.7rem;
    color: rgba(240, 237, 227, 0.2);
  }
</style>

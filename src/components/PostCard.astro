---
// src/components/PostCard.astro — one post as a card.
// `featured` gives the large card at the top of the blog page. On a wide
// screen it puts the image and the text side by side.
import PostPlaceholder from "./PostPlaceholder.astro";
import { href } from "../lib/url";
import { decodeEntities } from "../lib/text";
import type { Post } from "../lib/wp";

interface Props {
  post: Post;
  featured?: boolean;
  // The grid alternates green and violet. The blog filter script updates
  // this value on the visible cards.
  accent?: "green" | "violet";
}

const { post, featured = false, accent = "green" } = Astro.props;
const f = post.postFields;
const title = decodeEntities(post.title);

// The blog filters match on these slugs. A post can have more than one
// category. The card label shows the first one.
const categories = post.categories?.nodes ?? [];
const category = categories[0];

// The author relation returns a list. Take the first author.
const author = f?.author?.nodes?.[0]?.authorFields;
const authorName = [author?.name, author?.lastName]
  .filter(Boolean)
  .join(" ");

const image = f?.postImage?.node;
const photo = author?.profilePhoto?.node;

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-US", { dateStyle: "medium" });
---

<!-- The featured card slides in like the large Team cards. A grid card
     rises with the soft reveal. The .soft motion uses `translate`, so the
     hover `transform` stays free. -->
<a
  class:list={[
    "card",
    "soft",
    featured ? "slide-left card--featured" : "reveal",
  ]}
  href={href(`/blog/${post.slug}/`)}
  data-categories={categories.map((c) => c.slug).join(" ")}
  data-accent={accent}
>
  {featured && <span class="card-ghost" aria-hidden="true">01</span>}
  <div class="card-media">
    {
      image?.sourceUrl ? (
        <img src={image.sourceUrl} alt={image.altText ?? title} loading="lazy" />
      ) : (
        <PostPlaceholder seed={post.slug} />
      )
    }
  </div>

  <div class="card-body">
    <div class="card-meta">
      <time datetime={post.date}>{fmt(post.date)}</time>
      {f?.readingTime && <span>{f.readingTime} min read</span>}
      {category && <span class="card-cat">{category.name}</span>}
      <span class="card-arrow" aria-hidden="true">→</span>
    </div>

    <h2 class="card-title">{title}</h2>
    {f?.subtitle && <p class="card-subtitle">{f.subtitle}</p>}
    {f?.description && <p class="card-desc">{f.description}</p>}

    {
      authorName && (
        <div class="card-author">
          {photo?.sourceUrl && (
            <img
              class="card-author-photo"
              src={photo.sourceUrl}
              alt={authorName}
              loading="lazy"
            />
          )}
          <span class="card-author-text">
            <span class="card-author-name">{authorName}</span>
            {author?.role && <span class="card-author-role">{author.role}</span>}
          </span>
        </div>
      )
    }
    {featured && <span class="card-more">Read the post →</span>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--bdark);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    /* This scoped rule beats the global .reveal.soft rule, so the reveal
       transition (opacity, translate) must live here too. */
    transition:
      border-color 0.2s,
      transform 0.2s,
      opacity 1s cubic-bezier(0.4, 0, 0.2, 1),
      translate 1.1s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay:
      0s, 0s, calc(var(--reveal-index, 0) * 100ms),
      calc(var(--reveal-index, 0) * 100ms);
  }
  .card:hover {
    border-color: rgba(var(--green-rgb), 0.4);
    transform: translateY(-4px);
  }

  .card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgba(var(--green-rgb), 0.05);
  }
  .card-media img,
  .card-media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .card:hover .card-media img,
  .card:hover .card-media :global(svg) {
    transform: scale(1.03);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.5rem;
  }
  .card-meta {
    display: flex;
    gap: 1rem;
    font-family: var(--mono);
    font-weight: 400; /* DM Mono loads 400 and 500 only */
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 30%, transparent);
  }

  .card-title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.55rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--paper);
    transition: color 0.2s;
  }
  .card:hover .card-title {
    color: var(--green);
  }
  .card-subtitle {
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    line-height: 1.5;
  }
  .card-desc {
    font-size: 0.84rem;
    color: color-mix(in srgb, var(--paper) 40%, transparent);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-author {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--bdark);
  }
  .card-author-photo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }
  .card-author-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .card-author-name {
    font-size: 0.8rem;
    color: var(--paper);
  }
  .card-author-role {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 30%, transparent);
  }

  /* ── Category and hover arrow ── */
  .card {
    position: relative;
  }
  .card-cat {
    color: var(--green);
  }
  .card-arrow {
    margin-left: auto;
    color: var(--green);
    opacity: 0;
    translate: -6px 0;
    transition:
      opacity 0.25s,
      translate 0.25s;
  }
  .card:hover .card-arrow {
    opacity: 1;
    translate: 0 0;
  }
  /* Every second card in the grid uses the violet accent. */
  .card[data-accent="violet"]:hover {
    border-color: rgba(var(--violet-light-rgb), 0.4);
  }
  .card[data-accent="violet"]:hover .card-title,
  .card[data-accent="violet"] .card-arrow,
  .card[data-accent="violet"] .card-cat {
    color: var(--violet-light);
  }

  /* ── Featured card ── */
  .card--featured::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--green),
      rgba(var(--green-rgb), 0) 60%
    );
  }
  .card--featured .card-media {
    position: relative;
  }
  /* A green tint on the image. It goes away on hover. */
  .card--featured .card-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(var(--green-rgb), 0.16);
    mix-blend-mode: color;
    transition: opacity 0.4s;
  }
  .card--featured:hover .card-media::after {
    opacity: 0;
  }
  .card-ghost {
    display: none;
  }
  .card--featured .card-body {
    position: relative;
    z-index: 1;
  }
  .card--featured .card-title {
    font-size: clamp(1.9rem, 3.2vw, 2.8rem);
    line-height: 1.05;
  }
  .card--featured .card-subtitle {
    font-size: 1rem;
  }
  .card--featured .card-desc {
    -webkit-line-clamp: 4;
    font-size: 0.92rem;
  }
  .card--featured .card-author-photo {
    width: 42px;
    height: 42px;
  }
  .card--featured .card-author-name {
    font-size: 0.88rem;
  }
  .card-more {
    margin-top: 0.4rem;
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
  }

  @media (width >= 64em) {
    .card--featured {
      flex-direction: row;
    }
    .card--featured .card-media {
      flex: 0 0 55%;
      aspect-ratio: auto;
      min-height: 360px;
    }
    .card--featured .card-body {
      flex: 1;
      justify-content: center;
      gap: 0.9rem;
      padding: 2.5rem;
    }
    /* The large number behind the text. */
    .card-ghost {
      position: absolute;
      right: 1.5rem;
      bottom: -0.15em;
      z-index: 0;
      display: block;
      font-family: var(--bebas);
      font-weight: 400;
      font-size: 11rem;
      line-height: 1;
      color: color-mix(in srgb, var(--paper) 5%, transparent);
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-arrow,
    .card--featured .card-media::after {
      transition: none;
    }
  }
</style>

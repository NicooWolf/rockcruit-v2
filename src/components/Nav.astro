---
// src/components/Nav.astro — one canonical nav (prototypes drifted; normalized here).
// Canonical decisions: dropdown order = 01 RaaS / 02 Contingency; Blog link added.
// "Open Positions" → /#contact until its real destination is decided (open ledger).
import { href } from "../lib/url";
import { WP_ENABLED } from "../lib/wp";
import RockcruitWordmark from "../assets/icons/rockcruit-white-title.svg";

const path = Astro.url.pathname;
const isActive = (p: string) => (p === "/" ? path === "/" : path.startsWith(p));
const showBlog = WP_ENABLED;
---

<nav>
  <a href={href("/")} class="nav-logo">
    <!-- The width and the height give the size before the style applies. They
         must hold the same values as .logo-mark. -->
    <RockcruitWordmark
      class="logo-mark"
      width="139"
      height="16"
      role="img"
      aria-label="Rockcruit"
    />
    <div class="nav-dot"></div>
  </a>
  <ul class="nav-links">
    <li class="nav-dropdown">
      <a href={href("/services")} class={isActive("/services") ? "active" : ""}>
        Services <span class="nav-dropdown-arrow">▾</span>
      </a>
      <div class="nav-dropdown-menu">
        <a class="service-link" href={href("/services#contingency")}
          ><span class="service-index contingency-index">01</span>
          Contingency Recruiting</a
        >
        <div class="nav-dropdown-divider"></div>
        <a class="service-link" href={href("/services#raas")}
          ><span class="service-index">02</span> Recruiting as a Service</a
        >
      </div>
    </li>
    <li>
      <a href={href("/team")} class={isActive("/team") ? "active" : ""}>Team</a>
    </li>
    <li>
      <a href={href("/process")} class={isActive("/process") ? "active" : ""}
        >Process</a
      >
    </li>
    <li>
      <a href={href("/faq")} class={isActive("/faq") ? "active" : ""}>FAQ</a>
    </li>
    {
      showBlog && (
        <li>
          <a href={href("/blog")} class={isActive("/blog") ? "active" : ""}>
            Blog
          </a>
        </li>
      )
    }
  </ul>
  <div class="nav-actions">
    <a href={href("/#contact")} class="nav-open">Open Positions</a>
    <a href={href("/#contact")} class="nav-cta">Hire With Us</a>
  </div>
  <div class="nav-mobile">
    <button
      class="nav-mobile-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="nav-mobile-panel"
    >
      <span></span>
      <span></span>
    </button>
    <div class="nav-mobile-panel" id="nav-mobile-panel" hidden>
      <div class="nav-mobile-sheet">
        <ul class="nav-mobile-list">
          <li>
            <a class="service-link" href={href("/services#contingency")}>
              <span class="nav-mobile-idx service-index contingency-index"
                >01</span
              >
              <span class="nav-mobile-label">Contingency Recruiting</span>
            </a>
          </li>
          <li>
            <a class="service-link" href={href("/services#raas")}>
              <span class="nav-mobile-idx service-index">02</span>
              <span class="nav-mobile-label">Recruiting as a Service</span>
            </a>
          </li>
          <li>
            <a href={href("/team")} class={isActive("/team") ? "active" : ""}>
              <span class="nav-mobile-idx">03</span>
              <span class="nav-mobile-label">Team</span>
            </a>
          </li>
          <li>
            <a
              href={href("/process")}
              class={isActive("/process") ? "active" : ""}
            >
              <span class="nav-mobile-idx">04</span>
              <span class="nav-mobile-label">Process</span>
            </a>
          </li>
          <li>
            <a href={href("/faq")} class={isActive("/faq") ? "active" : ""}>
              <span class="nav-mobile-idx">05</span>
              <span class="nav-mobile-label">FAQ</span>
            </a>
          </li>
          {
            showBlog && (
              <li>
                <a
                  href={href("/blog")}
                  class={isActive("/blog") ? "active" : ""}
                >
                  <span class="nav-mobile-idx">06</span>
                  <span class="nav-mobile-label">Blog</span>
                </a>
              </li>
            )
          }
        </ul>
        <div class="nav-mobile-cta">
          <a href={href("/#contact")} class="nav-mobile-open">
            Open Positions
            <svg
              class="nav-mobile-arrow"
              width="12"
              height="12"
              viewBox="0 0 12 12"
              aria-hidden="true"
            >
              <path
                d="M3 9L9 3M9 3H4.5M9 3V7.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href={href("/#contact")} class="nav-mobile-hire">
            Hire With Us
            <svg
              class="nav-mobile-arrow"
              width="12"
              height="12"
              viewBox="0 0 12 12"
              aria-hidden="true"
            >
              <path
                d="M3 9L9 3M9 3H4.5M9 3V7.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <p class="nav-mobile-foot">
          <span class="nav-mobile-brand">Rockcruit</span>
          <span class="nav-mobile-meta">Tech headhunters · LATAM</span>
        </p>
      </div>
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* The top inset fills the curved area of a phone screen. Without it, the
       page shows through above the bar. The inset stands alone: a browser
       without env() drops this one line and keeps the side padding. */
    padding: 0 5%;
    padding-top: env(safe-area-inset-top, 0px);
    height: calc(54px + env(safe-area-inset-top, 0px));
    background: var(--ink);
    /* Do not add a backdrop filter here. iOS gives the top strip the color of
       the bar, but it stops when the bar has a backdrop filter. The strip then
       shows the page and a gap appears. The background is solid, so a blur
       gives no gain. See WebKit change f1caad5. */
    border-bottom: 1px solid var(--bdark);
    transition:
      transform 0.4s ease,
      opacity 0.4s ease;
    /* The gap between two rows of the mobile cascade, and the length of one
       fade. The category menu in HireForm uses the same numbers. */
    --cascade-step: 80ms;
    --cascade-fade: 220ms;
  }
  nav.is-open {
    /* Sit above the grain overlay so the blur sheet covers the page.
       The bar keeps its ink color and white mark. */
    z-index: 960;
  }
  .nav-logo {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  /* The mark replaces the old Bebas Neue word. --logo-height is the one knob.
     The width comes from the ratio of the file, 209 to 24.
     Do not use width:auto here. An automatic width lets the browser take the
     size from the width attribute of the file, 209px, and the mark then grows
     after a client-side navigation. */
  .logo-mark {
    --logo-height: 1rem;
    display: block;
    height: var(--logo-height);
    width: calc(var(--logo-height) * 209 / 24);
    flex: none;
  }
  .nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 2.5s ease infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.8);
      opacity: 0.4;
    }
  }
  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.82rem;
    color: rgba(240, 237, 227, 0.4);
    text-decoration: none;
    transition: color 0.2s;
    cursor: pointer;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--paper);
  }
  .nav-links a.active {
    border-bottom: 1px solid var(--paper);
    padding-bottom: 1px;
  }
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(20, 18, 16, 0.98);
    border: 1px solid var(--bdark);
    border-radius: 8px;
    min-width: 230px;
    padding: 0.4rem 0;
    z-index: 600;
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu,
  .nav-dropdown.is-open .nav-dropdown-menu {
    display: block;
  }
  .nav-dropdown-menu::before {
    content: "";
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
    background: transparent;
  }
  .nav-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.1rem;
    font-size: 0.8rem;
    color: rgba(240, 237, 227, 0.5);
    text-decoration: none;
    transition:
      color 0.2s,
      background 0.2s;
    white-space: nowrap;
  }
  .nav-dropdown-menu a:hover {
    color: var(--paper);
    background: rgba(255, 255, 255, 0.04);
  }
  .service-index {
    font-family: var(--mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
    font-weight: 400;
  }
  .contingency-index {
    color: var(--violet);
  }
  .service-link.is-selected .service-index {
    font-weight: 700;
  }
  .nav-dropdown-divider {
    height: 1px;
    background: var(--bdark);
    margin: 0.3rem 0;
  }
  .nav-dropdown-arrow {
    display: inline-block;
    margin-left: 0.25rem;
    font-size: 0.6rem;
    transition: transform 0.2s;
  }
  .nav-dropdown:hover .nav-dropdown-arrow,
  .nav-dropdown:focus-within .nav-dropdown-arrow,
  .nav-dropdown.is-open .nav-dropdown-arrow {
    transform: rotate(180deg);
  }
  .nav-mobile {
    display: none;
  }
  .nav-mobile-toggle {
    /* Two lines only, no border. The button keeps a 40px touch area. */
    position: relative;
    z-index: 2;
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .nav-mobile-toggle span {
    width: 22px;
    height: 1px;
    background: var(--paper);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease,
      background-color 0.25s ease;
  }
  nav.is-open .nav-mobile-toggle span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  nav.is-open .nav-mobile-toggle span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .nav-mobile-panel {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: calc(54px + env(safe-area-inset-top, 0px) + 1.25rem) 5%
      calc(1.5rem + env(safe-area-inset-bottom, 0px));
    /* The sheet is dark and open. The blur reads the page behind it.
       Do not put this filter on the bar. The bar must stay solid ink. */
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    color: var(--paper);
    overflow: hidden;
  }
  .nav-mobile-sheet {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: scroll;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    touch-action: pan-y;
  }
  .nav-mobile-panel[hidden] {
    display: none;
  }
  .nav-mobile-panel:not([hidden]) {
    animation: nav-panel-in var(--cascade-fade) ease both;
  }
  .nav-mobile-panel:not([hidden]) .nav-mobile-list > li,
  .nav-mobile-panel:not([hidden]) .nav-mobile-cta a,
  .nav-mobile-panel:not([hidden]) .nav-mobile-foot {
    animation: nav-row-in var(--cascade-fade) ease both;
    animation-delay: calc(var(--in-step, 0) * var(--cascade-step));
  }
  .nav-mobile-panel.is-closing:not([hidden]) {
    pointer-events: none;
    animation: nav-panel-out var(--cascade-fade) ease both;
    animation-delay: var(--out-delay, 0ms);
  }
  .nav-mobile-panel.is-closing:not([hidden]) .nav-mobile-list > li,
  .nav-mobile-panel.is-closing:not([hidden]) .nav-mobile-cta a,
  .nav-mobile-panel.is-closing:not([hidden]) .nav-mobile-foot {
    animation: nav-row-out var(--cascade-fade) ease both;
    animation-delay: calc(var(--out-step, 0) * var(--cascade-step));
  }
  @keyframes nav-panel-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes nav-panel-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes nav-row-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nav-row-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .nav-mobile-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
  }
  .nav-mobile-list > li {
    border-bottom: 1px solid var(--bdark);
  }
  .nav-mobile-list a {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0;
    color: var(--paper);
    font-family: var(--bebas);
    font-size: clamp(2.75rem, 9.3vw, 3.85rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-mobile-list a:hover,
  .nav-mobile-list a:focus,
  .nav-mobile-list a:focus-visible,
  .nav-mobile-list a:active,
  .nav-mobile-list a.active,
  .nav-mobile-list a.is-selected {
    color: var(--paper);
  }
  .nav-mobile-idx {
    flex: none;
    width: 2.1rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 42%, transparent);
  }
  .nav-mobile-idx.service-index {
    font-size: 0.82rem;
  }
  .nav-mobile-label {
    min-width: 0;
    display: block;
    line-height: 0.8;
    /* Bebas Neue leaves empty font space under the caps. Trim it so the
       glyphs sit on the bottom of the span. */
    text-box-trim: trim-end;
    text-box-edge: cap alphabetic;
  }
  .nav-mobile-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }
  .nav-mobile-open,
  .nav-mobile-hire {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--paper);
    font-family: var(--sans);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s;
  }
  .nav-mobile-open:hover,
  .nav-mobile-open:focus-visible,
  .nav-mobile-hire:hover,
  .nav-mobile-hire:focus-visible {
    color: var(--green);
  }
  .nav-mobile-arrow {
    display: block;
    flex: none;
  }
  .nav-mobile-foot {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 2rem;
  }
  .nav-mobile-brand {
    font-family: var(--bebas);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: var(--paper);
  }
  .nav-mobile-meta {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 42%, transparent);
  }
  .nav-actions {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-cta {
    background: var(--green);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.45rem 1.2rem;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .nav-cta:hover {
    background: var(--green-light);
  }
  .nav-open {
    font-size: 0.82rem;
    color: rgba(240, 237, 227, 0.5);
    text-decoration: none;
    border: 1px solid var(--bdark);
    border-radius: 4px;
    padding: 0.45rem 1.2rem;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .nav-open:hover {
    border-color: rgba(240, 237, 227, 0.4);
    color: var(--paper);
  }
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
    .nav-actions {
      display: none;
    }
    .nav-cta,
    .nav-open {
      display: none;
    }
    .nav-mobile {
      display: block;
      margin-left: auto;
    }
  }
  @media (max-width: 900px) {
    /* Small screens give little height, so the bar leaves while the reader
       goes down the page and comes back when the reader goes up. */
    nav.is-hidden {
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
    }
    nav.is-open.is-hidden {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    nav {
      transition: none;
    }
    /* The panel opens and closes in one step. A length of zero holds the
       cascade rules but takes the motion away. The script reads the same
       setting and writes the hidden attribute immediately. */
    nav {
      --cascade-step: 0ms;
      --cascade-fade: 0ms;
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  interface LenisLike {
    stop?: () => void;
    start?: () => void;
    scrollTo?: (
      target: Element | number,
      opts?: { immediate?: boolean },
    ) => void;
  }

  const pageLockSiblings = () =>
    document.body.querySelectorAll<HTMLElement>(
      ":scope > :not(nav):not(.ios-tint)",
    );

  let lockedScrollY = 0;
  let pageLocked = false;

  const eventInSheet = (event: Event) => {
    const target = event.target;
    if (!(target instanceof Node)) return false;
    return Boolean(
      document.querySelector(".nav-mobile-sheet")?.contains(target),
    );
  };

  const blockPageScroll = (event: Event) => {
    if (eventInSheet(event)) return;
    event.preventDefault();
  };

  const lockPage = (lock: boolean) => {
    const lenis = (window as unknown as { __lenis?: LenisLike }).__lenis;

    if (lock) {
      if (pageLocked) return;
      pageLocked = true;
      lockedScrollY = window.scrollY;
      document.documentElement.setAttribute("data-nav-open", "");
      pageLockSiblings().forEach((el) => {
        el.inert = true;
      });
      document.addEventListener("touchmove", blockPageScroll, {
        passive: false,
      });
      document.addEventListener("wheel", blockPageScroll, { passive: false });
      lenis?.stop?.();
      return;
    }

    if (!pageLocked) return;
    pageLocked = false;
    document.removeEventListener("touchmove", blockPageScroll);
    document.removeEventListener("wheel", blockPageScroll);
    pageLockSiblings().forEach((el) => {
      el.inert = false;
    });

    // Do not pin the body. A fixed body sets scroll to 0. The browser then
    // jumps to the hash title, and a restore scrolls back. That looks like a
    // reload. Keep the hash off while overflow unlocks, then put it back.
    const { pathname, search, hash } = window.location;
    if (hash) {
      history.replaceState(history.state, "", pathname + search);
    }
    document.documentElement.removeAttribute("data-nav-open");
    window.scrollTo({ top: lockedScrollY, left: 0, behavior: "instant" });
    if (hash) {
      history.replaceState(history.state, "", pathname + search + hash);
    }
    lenis?.scrollTo?.(lockedScrollY, { immediate: true });
    lenis?.start?.();
  };

  const initializeNav = () => {
    const nav = document.querySelector<HTMLElement>("nav");
    if (!nav || nav.dataset.initialized === "true") return;
    nav.dataset.initialized = "true";

    const serviceLinks = nav.querySelectorAll<HTMLAnchorElement>(
      ".nav-dropdown .service-link",
    );
    const desktopServices = nav.querySelector<HTMLElement>(".nav-dropdown");
    const mobileNav = nav.querySelector<HTMLElement>(".nav-mobile");
    const mobileNavToggle =
      nav.querySelector<HTMLButtonElement>(".nav-mobile-toggle");
    const mobilePanel = nav.querySelector<HTMLElement>(".nav-mobile-panel");

    const clearSelection = (dropdown: HTMLElement) => {
      dropdown
        .querySelectorAll(".service-link")
        .forEach((link) => link.classList.remove("is-selected"));
    };

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const cascadeEnds = new WeakMap<
      HTMLElement,
      { onEnd: (event: AnimationEvent) => void; timer: number }
    >();

    const toMs = (time: string) =>
      time.trim().endsWith("ms") ? parseFloat(time) : parseFloat(time) * 1000;

    const animationEnd = (element: HTMLElement) => {
      const style = getComputedStyle(element);
      const delays = style.animationDelay.split(",");
      return style.animationDuration
        .split(",")
        .reduce(
          (longest, time, index) =>
            Math.max(longest, toMs(time) + toMs(delays[index % delays.length])),
          0,
        );
    };

    const cascadeRows = (panel: HTMLElement) =>
      [
        ...panel.querySelectorAll<HTMLElement>(
          ".nav-mobile-list > li, .nav-mobile-cta a, .nav-mobile-foot",
        ),
      ].filter((row) => row.getClientRects().length > 0);

    const cascadeLength = (panel: HTMLElement) => {
      return cascadeRows(panel).reduce(
        (longest, row) => Math.max(longest, animationEnd(row)),
        animationEnd(panel),
      );
    };

    const setCascadeOrder = (panel: HTMLElement) => {
      const rows = cascadeRows(panel);
      rows.forEach((row, index) => {
        row.style.setProperty("--in-step", String(index));
        row.style.setProperty("--out-step", String(rows.length - 1 - index));
      });
      const lastOut = Math.max(rows.length - 1, 0);
      panel.style.setProperty(
        "--out-delay",
        `calc(${lastOut} * var(--cascade-step))`,
      );
    };

    const stopCascade = (panel: HTMLElement) => {
      const close = cascadeEnds.get(panel);
      if (close) {
        panel.removeEventListener("animationend", close.onEnd);
        window.clearTimeout(close.timer);
        cascadeEnds.delete(panel);
      }
      panel.classList.remove("is-closing");
    };

    const openCascade = (panel: HTMLElement) => {
      stopCascade(panel);
      panel.hidden = false;
      setCascadeOrder(panel);
    };

    const closeCascade = (panel: HTMLElement, done: () => void) => {
      if (panel.hidden) {
        done();
        return;
      }
      if (panel.classList.contains("is-closing")) return;
      if (reducedMotion.matches) {
        stopCascade(panel);
        panel.hidden = true;
        done();
        return;
      }
      setCascadeOrder(panel);
      panel.classList.add("is-closing");

      const finish = () => {
        stopCascade(panel);
        panel.hidden = true;
        done();
      };
      const onEnd = (event: AnimationEvent) => {
        if (event.target !== panel) return;
        finish();
      };
      const timer = window.setTimeout(finish, cascadeLength(panel) + 100);
      cascadeEnds.set(panel, { onEnd, timer });
      panel.addEventListener("animationend", onEnd);
    };

    let closeDones: Array<() => void> = [];
    const finishClose = () => {
      lockPage(false);
      const dones = closeDones;
      closeDones = [];
      dones.forEach((fn) => fn());
    };

    const setMobileNavOpen = (
      open: boolean,
      animate = true,
      onClosed?: () => void,
    ) => {
      if (!mobileNav || !mobileNavToggle || !mobilePanel) return;
      if (onClosed) closeDones.push(onClosed);

      const alreadyOpen =
        mobileNavToggle.getAttribute("aria-expanded") === "true";
      if (open === alreadyOpen) {
        if (open) return;
        if (mobilePanel.hidden) {
          finishClose();
          return;
        }
        if (mobilePanel.classList.contains("is-closing")) return;
      }

      mobileNavToggle.setAttribute("aria-expanded", String(open));
      mobileNavToggle.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu",
      );
      nav.classList.toggle("is-open", open);
      mobileNav.classList.toggle("is-open", open);

      if (open) {
        closeDones = [];
        nav.classList.remove("is-hidden");
        lockPage(true);
        openCascade(mobilePanel);
        return;
      }

      if (animate) {
        closeCascade(mobilePanel, finishClose);
        return;
      }
      stopCascade(mobilePanel);
      mobilePanel.hidden = true;
      finishClose();
    };

    const closeDropdown = (dropdown: HTMLElement) => {
      dropdown.classList.remove("is-open");
      clearSelection(dropdown);
    };

    // A link to the same page gives no navigation, and a link to the current
    // hash gives no hashchange event. Write the hash and jump in both cases.
    const jumpToSection = (link: HTMLAnchorElement) => {
      const url = new URL(link.href);
      if (url.pathname !== window.location.pathname) return false;

      if (window.location.hash !== url.hash) {
        history.pushState(
          history.state,
          "",
          url.pathname + url.search + url.hash,
        );
      }

      // The layout listens for this event and holds the section hash while the
      // jump runs. holdBar keeps the bar on screen through the jump.
      window.dispatchEvent(new Event("hashchange"));

      const target = document.getElementById(
        decodeURIComponent(url.hash.slice(1)),
      );
      // Show the target's revealed content now, then land instantly — a jump
      // must render in one frame, not wait out a multi-second smooth scroll.
      if (target) {
        if (target.classList.contains("reveal")) target.classList.add("on");
        target
          .querySelectorAll(".reveal:not(.on)")
          .forEach((el) => el.classList.add("on"));
        target.scrollIntoView({ behavior: "instant", block: "start" });
      }

      return true;
    };

    const followLink = (link: HTMLAnchorElement) => {
      if (jumpToSection(link)) return;
      const url = new URL(link.href);
      void navigate(url.pathname + url.search + url.hash);
    };

    serviceLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        if (desktopServices) {
          clearSelection(desktopServices);
          link.classList.add("is-selected");
          desktopServices.classList.add("is-open");
        }

        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button)
          return;
        if (jumpToSection(link)) event.preventDefault();
      });
    });

    desktopServices?.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!desktopServices.contains(document.activeElement)) {
          if (desktopServices.matches(":hover")) return;
          closeDropdown(desktopServices);
        }
      });
    });

    desktopServices?.addEventListener("mouseleave", () => {
      closeDropdown(desktopServices);
    });

    mobileNavToggle?.addEventListener("click", () => {
      setMobileNavOpen(
        mobileNavToggle.getAttribute("aria-expanded") !== "true",
      );
    });

    nav.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest(".nav-mobile-toggle")) return;
      const link = event.target.closest("a");
      if (!(link instanceof HTMLAnchorElement)) return;
      if (mobileNavToggle?.getAttribute("aria-expanded") !== "true") return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button)
        return;

      event.preventDefault();
      setMobileNavOpen(false, true, () => followLink(link));
    });

    nav.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (desktopServices) closeDropdown(desktopServices);
      setMobileNavOpen(false);
      mobileNavToggle?.focus();
    });

    // A page load starts with every menu closed. The hash only marks the
    // matching number, which stays hidden until the user opens the dropdown.
    setMobileNavOpen(false, false);
    if (desktopServices) closeDropdown(desktopServices);

    const serviceHash = ["#contingency", "#raas"].includes(window.location.hash)
      ? window.location.hash
      : "";
    if (serviceHash) {
      nav
        .querySelectorAll<HTMLAnchorElement>(
          `.service-link[href$="${serviceHash}"]`,
        )
        .forEach((link) => link.classList.add("is-selected"));
    }
  };

  // ── The bar leaves on the way down and returns on the way up.
  // CSS applies this only below 900px. The listener sits on the window, so it
  // survives a client-side navigation and reads the current bar each time.
  const MOVE_STEP = 8; // px, ignores the jitter of a touch screen
  const TOP_ZONE = 40; // px, the bar always shows this near the top
  const JUMP_HOLD_MS = 400; // ms, keep the bar after a hash jump

  let lastDepth = window.scrollY;
  let framePending = false;
  let holdBarUntil = 0;

  const updateBar = () => {
    const bar = document.querySelector<HTMLElement>("nav");
    if (!bar) return;

    const depth = Math.max(window.scrollY, 0);
    const move = depth - lastDepth;
    if (Math.abs(move) < MOVE_STEP) return;
    lastDepth = depth;

    const panelOpen = bar.classList.contains("is-open");
    if (panelOpen || depth <= TOP_ZONE || performance.now() < holdBarUntil) {
      bar.classList.remove("is-hidden");
      return;
    }

    bar.classList.toggle("is-hidden", move > 0);
  };

  const showBar = () => {
    lastDepth = window.scrollY;
    document.querySelector<HTMLElement>("nav")?.classList.remove("is-hidden");
  };

  // Items 01 and 02 jump to a hash below the fold. That jump looks like a
  // reader scroll, so updateBar hid the bar. Hold the bar through the jump.
  const holdBar = () => {
    holdBarUntil = performance.now() + JUMP_HOLD_MS;
    showBar();
  };

  const closeLiveMobileNav = () => {
    const bar = document.querySelector<HTMLElement>("nav");
    const panel = bar?.querySelector<HTMLElement>(".nav-mobile-panel");
    const toggle = bar?.querySelector<HTMLButtonElement>(".nav-mobile-toggle");
    const mobile = bar?.querySelector<HTMLElement>(".nav-mobile");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open navigation menu");
    bar?.classList.remove("is-open");
    mobile?.classList.remove("is-open");
    if (panel) {
      panel.classList.remove("is-closing");
      panel.hidden = true;
    }
    lockPage(false);
  };

  const bindNavDocument = () => {
    const root = window as Window & { __rcNavBound?: boolean };
    if (root.__rcNavBound) return;
    root.__rcNavBound = true;

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      const dropdown = document.querySelector<HTMLElement>(".nav-dropdown");
      if (dropdown && !dropdown.contains(target)) {
        dropdown.classList.remove("is-open");
        dropdown
          .querySelectorAll(".service-link")
          .forEach((link) => link.classList.remove("is-selected"));
      }
    });

    window
      .matchMedia("(max-width: 900px)")
      .addEventListener("change", (event) => {
        if (!event.matches) closeLiveMobileNav();
      });

    window.addEventListener(
      "scroll",
      () => {
        if (framePending) return;
        framePending = true;
        requestAnimationFrame(() => {
          framePending = false;
          updateBar();
        });
      },
      { passive: true },
    );

    window.addEventListener("hashchange", holdBar);
    window.addEventListener("rockcruit:show-bar", holdBar);
    document.addEventListener("astro:before-swap", closeLiveMobileNav);
    document.addEventListener("astro:page-load", () => {
      initializeNav();
      showBar();
    });
  };

  bindNavDocument();
  initializeNav();
</script>

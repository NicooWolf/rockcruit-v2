---
// src/components/Nav.astro — one canonical nav (prototypes drifted; normalized here).
// Canonical decisions: dropdown order = 01 RaaS / 02 Contingency; Blog link added.
// "Open Positions" → /#contact until its real destination is decided (open ledger).
import { href } from "../lib/url";
import RockcruitWordmark from "../assets/icons/rockcruit-white-title.svg";

const path = Astro.url.pathname;
const isActive = (p: string) => (p === "/" ? path === "/" : path.startsWith(p));
---

<nav>
  <a href={href("/")} class="nav-logo">
    <!-- The width and the height give the size before the style applies. They
         must hold the same values as .logo-mark. -->
    <RockcruitWordmark
      class="logo-mark"
      width="139"
      height="16"
      role="img"
      aria-label="Rockcruit"
    />
    <div class="nav-dot"></div>
  </a>
  <ul class="nav-links">
    <li><a href={href("/")} class={isActive("/") ? "active" : ""}>Home</a></li>
    <li class="nav-dropdown">
      <a href={href("/services")} class={isActive("/services") ? "active" : ""}>
        Services <span class="nav-dropdown-arrow">▾</span>
      </a>
      <div class="nav-dropdown-menu">
        <a class="service-link" href={href("/services#contingency")}
          ><span class="service-index contingency-index">01</span>
          Contingency Recruiting</a
        >
        <div class="nav-dropdown-divider"></div>
        <a class="service-link" href={href("/services#raas")}
          ><span class="service-index">02</span> Recruiting as a Service</a
        >
      </div>
    </li>
    <li>
      <a href={href("/team")} class={isActive("/team") ? "active" : ""}>Team</a>
    </li>
    <li>
      <a href={href("/process")} class={isActive("/process") ? "active" : ""}
        >Process</a
      >
    </li>
    <li>
      <a href={href("/faq")} class={isActive("/faq") ? "active" : ""}>FAQ</a>
    </li>
    <li>
      <a href={href("/blog")} class={isActive("/blog") ? "active" : ""}>Blog</a>
    </li>
  </ul>
  <div class="nav-actions">
    <a href={href("/#contact")} class="nav-open">Open Positions</a>
    <a href={href("/#contact")} class="nav-cta">Hire With Us</a>
  </div>
  <div class="nav-mobile">
    <button
      class="nav-mobile-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="nav-mobile-panel"
    >
      <span></span>
      <span></span>
    </button>
    <div class="nav-mobile-panel" id="nav-mobile-panel" hidden>
      <div class="nav-mobile-services">
        <button
          class="nav-mobile-services-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-mobile-services-menu"
        >
          Services <span class="nav-dropdown-arrow">▾</span>
        </button>
        <div
          id="nav-mobile-services-menu"
          class="nav-mobile-services-menu"
          hidden
        >
          <a class="service-link" href={href("/services#contingency")}
            ><span class="service-index contingency-index">01</span>
            Contingency Recruiting</a
          >
          <a class="service-link" href={href("/services#raas")}
            ><span class="service-index">02</span> Recruiting as a Service</a
          >
        </div>
      </div>
      <a href={href("/team")} class={isActive("/team") ? "active" : ""}>Team</a>
      <a href={href("/process")} class={isActive("/process") ? "active" : ""}
        >Process</a
      >
      <a href={href("/faq")} class={isActive("/faq") ? "active" : ""}>FAQ</a>
      <a href={href("/blog")} class={isActive("/blog") ? "active" : ""}>Blog</a>
      <a href={href("/#contact")} class="nav-mobile-open">Open Positions</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* The top inset fills the curved area of a phone screen. Without it, the
       page shows through above the bar. The inset stands alone: a browser
       without env() drops this one line and keeps the side padding. */
    padding: 0 5%;
    padding-top: env(safe-area-inset-top, 0px);
    height: calc(54px + env(safe-area-inset-top, 0px));
    background: var(--ink);
    /* Do not add a backdrop filter here. iOS gives the top strip the color of
       the bar, but it stops when the bar has a backdrop filter. The strip then
       shows the page and a gap appears. The background is solid, so a blur
       gives no gain. See WebKit change f1caad5. */
    border-bottom: 1px solid var(--bdark);
    transition:
      transform 0.4s ease,
      opacity 0.4s ease;
    /* The gap between two rows of the mobile cascade, and the length of one
       fade. The category menu in HireForm uses the same numbers.
       --cascade-span is the time of the slide of the panel. See
       .nav-mobile-panel. */
    --cascade-step: 132ms;
    --cascade-fade: 180ms;
    --cascade-span: calc(7 * var(--cascade-step) + var(--cascade-fade));
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  /* The mark replaces the old Bebas Neue word. --logo-height is the one knob.
     The width comes from the ratio of the file, 209 to 24.
     Do not use width:auto here. An automatic width lets the browser take the
     size from the width attribute of the file, 209px, and the mark then grows
     after a client-side navigation. */
  .logo-mark {
    --logo-height: 1rem;
    display: block;
    height: var(--logo-height);
    width: calc(var(--logo-height) * 209 / 24);
    flex: none;
  }
  .nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 2.5s ease infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.8);
      opacity: 0.4;
    }
  }
  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.82rem;
    color: rgba(240, 237, 227, 0.4);
    text-decoration: none;
    transition: color 0.2s;
    cursor: pointer;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--paper);
  }
  .nav-links a.active {
    border-bottom: 1px solid var(--paper);
    padding-bottom: 1px;
  }
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(20, 18, 16, 0.98);
    border: 1px solid var(--bdark);
    border-radius: 8px;
    min-width: 230px;
    padding: 0.4rem 0;
    z-index: 600;
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu,
  .nav-dropdown.is-open .nav-dropdown-menu {
    display: block;
  }
  .nav-dropdown-menu::before {
    content: "";
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
    background: transparent;
  }
  .nav-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.1rem;
    font-size: 0.8rem;
    color: rgba(240, 237, 227, 0.5);
    text-decoration: none;
    transition:
      color 0.2s,
      background 0.2s;
    white-space: nowrap;
  }
  .nav-dropdown-menu a:hover {
    color: var(--paper);
    background: rgba(255, 255, 255, 0.04);
  }
  .service-index {
    font-family: var(--mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
    font-weight: 400;
  }
  .contingency-index {
    color: var(--violet);
  }
  .service-link.is-selected .service-index {
    font-weight: 700;
  }
  .nav-dropdown-divider {
    height: 1px;
    background: var(--bdark);
    margin: 0.3rem 0;
  }
  .nav-dropdown-arrow {
    display: inline-block;
    margin-left: 0.25rem;
    font-size: 0.6rem;
    transition: transform 0.2s;
  }
  .nav-dropdown:hover .nav-dropdown-arrow,
  .nav-dropdown:focus-within .nav-dropdown-arrow,
  .nav-dropdown.is-open .nav-dropdown-arrow,
  .nav-mobile-services.is-open .nav-dropdown-arrow {
    transform: rotate(180deg);
  }
  .nav-mobile {
    display: none;
    position: relative;
  }
  .nav-mobile-toggle {
    /* Two lines only, no border. The button keeps a 40px touch area. */
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .nav-mobile-toggle span {
    width: 22px;
    height: 1px;
    background: var(--paper);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .nav-mobile.is-open .nav-mobile-toggle span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav-mobile.is-open .nav-mobile-toggle span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .nav-mobile-panel {
    position: fixed;
    top: calc(54px + env(safe-area-inset-top, 0px));
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 0.8rem 5% 1rem;
    background: var(--ink);
    border-bottom: 1px solid var(--bdark);
  }
  .nav-mobile-panel[hidden] {
    display: none;
  }
  /* ── The cascade of the mobile panel and of the Services menu ──
     The category menu in HireForm gives the model. The panel and its rows do
     one motion. The rows come in from the top down, one step after the other,
     and they leave from the bottom up. The panel opens like a slider: its
     height grows from zero, and its lower border goes down with the rows. The
     script gives each visible row a place with --in-step and --out-step, and
     it gives the panel its full height with --panel-height. The hidden
     attribute gives display:none, and display cannot animate, so the script
     writes the attribute only after the last row leaves. */
  .nav-mobile-panel:not([hidden]),
  .nav-mobile-services-menu:not([hidden]) {
    /* The rows must stay inside the box while the box grows. */
    overflow: hidden;
    max-height: var(--panel-height, none);
    animation:
      nav-panel-in var(--cascade-fade) ease both,
      nav-slide var(--cascade-span) ease both;
  }
  .nav-mobile-panel:not([hidden]) > *,
  .nav-mobile-services-menu:not([hidden]) > * {
    animation: nav-row-in var(--cascade-fade) ease both;
    animation-delay: calc(var(--in-step, 0) * var(--cascade-step));
  }
  .nav-mobile-panel.is-closing:not([hidden]),
  .nav-mobile-services-menu.is-closing:not([hidden]) {
    /* The panel still shows while it leaves. It must take no more taps. */
    pointer-events: none;
    /* The box shrinks with the rows. The background leaves at the end. */
    animation:
      nav-slide-out var(--cascade-span) ease both,
      nav-panel-out var(--cascade-fade) ease both;
    animation-delay: 0s, calc(var(--cascade-span) - var(--cascade-fade));
  }
  .nav-mobile-panel.is-closing:not([hidden]) > *,
  .nav-mobile-services-menu.is-closing:not([hidden]) > * {
    animation: nav-row-out var(--cascade-fade) ease both;
    animation-delay: calc(var(--out-step, 0) * var(--cascade-step));
  }
  @keyframes nav-panel-in {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nav-panel-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-5px);
    }
  }
  @keyframes nav-slide {
    from {
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
  @keyframes nav-slide-out {
    to {
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
  @keyframes nav-row-in {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nav-row-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-5px);
    }
  }
  .nav-mobile-panel > a,
  .nav-mobile-services-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    padding: 0.75rem 0;
    border: 0;
    border-bottom: 1px solid var(--bdark);
    background: transparent;
    color: var(--paper);
    font-family: var(--sans);
    font-size: 0.82rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .nav-mobile-panel > a.active {
    font-weight: 700;
  }
  .nav-mobile-services > div {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--bdark);
  }
  .nav-mobile-services > div[hidden] {
    display: none;
  }
  .nav-mobile-services .service-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.7rem;
    color: var(--paper);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .nav-mobile-panel > .nav-mobile-open {
    display: none;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-cta {
    background: var(--green);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.45rem 1.2rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .nav-cta:hover {
    background: var(--green-light);
  }
  .nav-open {
    font-size: 0.82rem;
    color: rgba(240, 237, 227, 0.5);
    text-decoration: none;
    border: 1px solid var(--bdark);
    border-radius: 4px;
    padding: 0.45rem 1.2rem;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .nav-open:hover {
    border-color: rgba(240, 237, 227, 0.4);
    color: var(--paper);
  }
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
    .nav-actions {
      margin-left: auto;
    }
    .nav-mobile {
      display: block;
      margin-left: 0.75rem;
    }
  }
  @media (max-width: 640px) {
    .nav-open {
      display: none;
    }
    .nav-mobile-panel > .nav-mobile-open {
      display: flex;
    }
  }
  @media (max-width: 900px) {
    /* Small screens give little height, so the bar leaves while the reader
       goes down the page and comes back when the reader goes up. */
    nav.is-hidden {
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    nav {
      transition: none;
    }
    /* The panel opens and closes in one step. A length of zero holds the
       cascade rules but takes the motion away. The script reads the same
       setting and writes the hidden attribute immediately. */
    nav {
      --cascade-step: 0ms;
      --cascade-fade: 0ms;
    }
  }
</style>

<script>
  const initializeNav = () => {
    const nav = document.querySelector<HTMLElement>("nav");
    if (!nav || nav.dataset.initialized === "true") return;
    nav.dataset.initialized = "true";

    const serviceLinks =
      nav.querySelectorAll<HTMLAnchorElement>(".service-link");
    const desktopServices = nav.querySelector<HTMLElement>(".nav-dropdown");
    const mobileNav = nav.querySelector<HTMLElement>(".nav-mobile");
    const mobileNavToggle =
      nav.querySelector<HTMLButtonElement>(".nav-mobile-toggle");
    const mobilePanel = nav.querySelector<HTMLElement>(".nav-mobile-panel");
    const mobileServices = nav.querySelector<HTMLElement>(
      ".nav-mobile-services",
    );
    const mobileServicesToggle = nav.querySelector<HTMLButtonElement>(
      ".nav-mobile-services-toggle",
    );
    const mobileServicesMenu = document.getElementById(
      "nav-mobile-services-menu",
    );
    const dropdowns = [desktopServices, mobileServices].filter(
      (dropdown): dropdown is HTMLElement => dropdown !== null,
    );

    const clearSelection = (dropdown: HTMLElement) => {
      dropdown
        .querySelectorAll(".service-link")
        .forEach((link) => link.classList.remove("is-selected"));
    };

    // ── The cascade of the mobile panel ──
    // The rows come in from the top down and they leave from the bottom up.
    // The CSS holds the animation. The script holds the order of the rows and
    // the hidden attribute, because display:none stops every animation.
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const cascadeEnds = new WeakMap<
      HTMLElement,
      { onEnd: (event: AnimationEvent) => void; timer: number }
    >();

    // The browser gives a time in seconds or in milliseconds.
    const toMs = (time: string) =>
      time.trim().endsWith("ms") ? parseFloat(time) : parseFloat(time) * 1000;

    // An element can run more than one animation. Take the longest one.
    const animationEnd = (element: HTMLElement) => {
      const style = getComputedStyle(element);
      const delays = style.animationDelay.split(",");
      return style.animationDuration
        .split(",")
        .reduce(
          (longest, time, index) =>
            Math.max(longest, toMs(time) + toMs(delays[index % delays.length])),
          0,
        );
    };

    const cascadeLength = (panel: HTMLElement) => {
      const rows = Array.from(panel.children).filter(
        (row): row is HTMLElement => row instanceof HTMLElement,
      );
      return rows.reduce(
        (longest, row) => Math.max(longest, animationEnd(row)),
        animationEnd(panel),
      );
    };

    // The slide needs a height. max-height:none cannot animate, so the script
    // measures the content and writes the value to --panel-height. The
    // measurement stops the animation first, because the first frame of the
    // slide takes the padding away and gives a short height.
    const fitPanel = (panel: HTMLElement) => {
      const saved = panel.style.animation;
      panel.style.animation = "none";
      const height = panel.scrollHeight;
      panel.style.animation = saved;
      panel.style.setProperty("--panel-height", `${height}px`);
    };

    // A row that the CSS hides at this width takes no place in the cascade.
    const setCascadeOrder = (panel: HTMLElement) => {
      const rows = Array.from(panel.children).filter(
        (row): row is HTMLElement =>
          row instanceof HTMLElement && row.getClientRects().length > 0,
      );
      rows.forEach((row, index) => {
        row.style.setProperty("--in-step", String(index));
        row.style.setProperty("--out-step", String(rows.length - 1 - index));
      });
    };

    const stopCascade = (panel: HTMLElement) => {
      const close = cascadeEnds.get(panel);
      if (close) {
        panel.removeEventListener("animationend", close.onEnd);
        window.clearTimeout(close.timer);
        cascadeEnds.delete(panel);
      }
      panel.classList.remove("is-closing");
    };

    const openCascade = (panel: HTMLElement) => {
      stopCascade(panel);
      panel.hidden = false;
      setCascadeOrder(panel);
      fitPanel(panel);
    };

    const closeCascade = (panel: HTMLElement, done: () => void) => {
      if (panel.hidden) {
        done();
        return;
      }
      // The panel already leaves. A second start would repeat the animation.
      if (panel.classList.contains("is-closing")) return;
      if (reducedMotion.matches) {
        stopCascade(panel);
        panel.hidden = true;
        done();
        return;
      }
      setCascadeOrder(panel);
      fitPanel(panel);
      panel.classList.add("is-closing");

      const finish = () => {
        stopCascade(panel);
        panel.hidden = true;
        done();
      };
      const onEnd = (event: AnimationEvent) => {
        // Every row sends this event. Answer only for the panel itself.
        if (event.target !== panel) return;
        finish();
      };
      // The event closes the panel. The timer closes it if the event never
      // comes, because a panel that stays open blocks the page.
      const timer = window.setTimeout(finish, cascadeLength(panel) + 100);
      cascadeEnds.set(panel, { onEnd, timer });
      panel.addEventListener("animationend", onEnd);
    };

    const setMobileServicesOpen = (open: boolean, animate = true) => {
      if (!mobileServices || !mobileServicesToggle || !mobileServicesMenu)
        return;
      mobileServicesToggle.setAttribute("aria-expanded", String(open));
      mobileServices.classList.toggle("is-open", open);
      if (open) {
        openCascade(mobileServicesMenu);
        // The panel must hold the Services menu. The menu still grows, so its
        // full height comes from scrollHeight. A larger value only lifts the
        // limit of the panel. closeCascade measures the true height again.
        if (mobilePanel) {
          mobilePanel.style.setProperty(
            "--panel-height",
            `${mobilePanel.scrollHeight + mobileServicesMenu.scrollHeight}px`,
          );
        }
        return;
      }
      if (animate) {
        closeCascade(mobileServicesMenu, () => clearSelection(mobileServices));
        return;
      }
      stopCascade(mobileServicesMenu);
      mobileServicesMenu.hidden = true;
      clearSelection(mobileServices);
    };

    const setMobileNavOpen = (open: boolean) => {
      if (!mobileNav || !mobileNavToggle || !mobilePanel) return;
      mobileNavToggle.setAttribute("aria-expanded", String(open));
      mobileNavToggle.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu",
      );
      mobileNav.classList.toggle("is-open", open);
      if (open) {
        openCascade(mobilePanel);
        return;
      }
      // The Services menu leaves inside the panel. It must not run a second
      // animation of its own, so it closes after the panel leaves.
      closeCascade(mobilePanel, () => setMobileServicesOpen(false, false));
    };

    const closeDropdown = (dropdown: HTMLElement) => {
      if (dropdown === mobileServices) {
        setMobileServicesOpen(false);
        return;
      }

      dropdown.classList.remove("is-open");
      clearSelection(dropdown);
    };

    // A link to the same page gives no navigation, and a link to the current
    // hash gives no hashchange event. Write the hash and jump in both cases.
    const jumpToSection = (link: HTMLAnchorElement) => {
      const url = new URL(link.href);
      if (url.pathname !== window.location.pathname) return false;

      if (window.location.hash !== url.hash) {
        history.pushState(
          history.state,
          "",
          url.pathname + url.search + url.hash,
        );
      }

      // The layout listens for this event and holds the section hash while the
      // jump runs.
      window.dispatchEvent(new Event("hashchange"));

      const target = document.getElementById(
        decodeURIComponent(url.hash.slice(1)),
      );
      target?.scrollIntoView({ block: "start" });

      return true;
    };

    serviceLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const dropdown = link.closest<HTMLElement>(
          ".nav-dropdown, .nav-mobile-services",
        );
        if (dropdown) {
          clearSelection(dropdown);
          link.classList.add("is-selected");
          if (dropdown === mobileServices) {
            setMobileNavOpen(true);
            setMobileServicesOpen(true);
          } else {
            dropdown.classList.add("is-open");
          }
        }

        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button)
          return;
        if (jumpToSection(link)) event.preventDefault();
      });
    });

    dropdowns.forEach((dropdown) => {
      dropdown.addEventListener("focusout", () => {
        requestAnimationFrame(() => {
          if (dropdown.contains(document.activeElement)) return;
          if (dropdown !== mobileServices && dropdown.matches(":hover")) return;
          closeDropdown(dropdown);
        });
      });
    });

    desktopServices?.addEventListener("mouseleave", () => {
      closeDropdown(desktopServices);
    });

    mobileNavToggle?.addEventListener("click", () => {
      setMobileNavOpen(
        mobileNavToggle.getAttribute("aria-expanded") !== "true",
      );
    });

    mobileServicesToggle?.addEventListener("click", () => {
      setMobileServicesOpen(
        mobileServicesToggle.getAttribute("aria-expanded") !== "true",
      );
    });

    mobilePanel
      ?.querySelectorAll<HTMLAnchorElement>(":scope > a")
      .forEach((link) => {
        link.addEventListener("click", () => setMobileNavOpen(false));
      });

    mobileNav?.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!mobileNav.contains(document.activeElement))
          setMobileNavOpen(false);
      });
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (desktopServices && !desktopServices.contains(target))
        closeDropdown(desktopServices);
      if (mobileNav && !mobileNav.contains(target)) setMobileNavOpen(false);
    });

    nav.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      // The panel closes the Services menu inside it. A second call here
      // would run the animation of the menu twice.
      if (desktopServices) closeDropdown(desktopServices);
      setMobileNavOpen(false);
      mobileNavToggle?.focus();
    });

    // A page load starts with every menu closed. The hash only marks the
    // matching number, which stays hidden until the user opens the dropdown.
    setMobileNavOpen(false);
    if (desktopServices) closeDropdown(desktopServices);

    const serviceHash = ["#contingency", "#raas"].includes(window.location.hash)
      ? window.location.hash
      : "";
    if (serviceHash) {
      nav
        .querySelectorAll<HTMLAnchorElement>(
          `.service-link[href$="${serviceHash}"]`,
        )
        .forEach((link) => link.classList.add("is-selected"));
    }
  };

  // ── The bar leaves on the way down and returns on the way up.
  // CSS applies this only below 900px. The listener sits on the window, so it
  // survives a client-side navigation and reads the current bar each time.
  const MOVE_STEP = 8; // px, ignores the jitter of a touch screen
  const TOP_ZONE = 40; // px, the bar always shows this near the top

  let lastDepth = window.scrollY;
  let framePending = false;

  const updateBar = () => {
    const bar = document.querySelector<HTMLElement>("nav");
    if (!bar) return;

    const depth = Math.max(window.scrollY, 0);
    const move = depth - lastDepth;
    if (Math.abs(move) < MOVE_STEP) return;
    lastDepth = depth;

    const panelOpen = bar.querySelector(".nav-mobile.is-open") !== null;
    if (panelOpen || depth <= TOP_ZONE) {
      bar.classList.remove("is-hidden");
      return;
    }

    bar.classList.toggle("is-hidden", move > 0);
  };

  const showBar = () => {
    lastDepth = window.scrollY;
    document.querySelector<HTMLElement>("nav")?.classList.remove("is-hidden");
  };

  window.addEventListener(
    "scroll",
    () => {
      if (framePending) return;
      framePending = true;
      requestAnimationFrame(() => {
        framePending = false;
        updateBar();
      });
    },
    { passive: true },
  );

  window.addEventListener("hashchange", showBar);

  initializeNav();
  document.addEventListener("astro:page-load", () => {
    initializeNav();
    showBar();
  });
</script>
